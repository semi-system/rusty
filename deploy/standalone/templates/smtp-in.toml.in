# Generated by setup.sh from templates/smtp-in.toml.in. Edit the template and run setup.sh again, or this file (setup.sh never overwrites it).
# The smtp-in service: its file accepts only the sections it uses (docs/docker.md).
hostname = "@MAIL_HOST@"
blob_dir = "/var/lib/rusty/blobs"

# The edge (HAProxy) passes port 25 through with a PROXY v2 header, accepted from the edge only (and loopback, from where the healthcheck probes).
[tls]
cert_file = "/etc/rusty-tls/cert.pem"
key_file = "/etc/rusty-tls/key.pem"

[smtp]
listen_25 = "0.0.0.0:2525"
proxy_protocol = true
trusted_proxies = ["10.77.0.2/32", "127.0.0.1/32"]

# The scanners of the `filter` profile (./setup.sh --filter): the virus scan first, then the spam scorer. The virus scan holds mail while clamd is down (451); the spam scorer lets it through.
#FILTER [filter]
#FILTER clamd_addr = "clamd:3310"
#FILTER rspamd_url = "http://rspamd:11333"

# A tenant's bucket keys are sealed to this service's key (docs/blob-stores.md): every service that opens message bodies holds the private half.
[unsealing]
key_files = ["/etc/rusty-keys/unseal.key"]

[store]
url = "postgres://rusty_smtp_in@db:5432/rusty"
password_file = "/run/secrets/pg_smtp_in"
sslmode = "verify-full"
ca_bundle = "/etc/rusty/db-ca.pem"
