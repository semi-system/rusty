# Generated by setup.sh from templates/ctl.toml.in. For `docker compose run --rm ctl ...` (rustyctl, docs/first-mail.md): it listens on nothing, so it has none of the listener sections.
hostname = "@MAIL_HOST@"
blob_dir = "/var/lib/rusty/blobs"
gc_grace_seconds = 604800

[outbound]
dkim_dir = "/var/lib/rusty/dkim"
public_ips = ["@PUBLIC_IP@"]

[dns_check]
enabled = true

# Secrets typed into the admin web or into rustyctl (DKIM keys, relay passwords, a bucket's keys) are sealed to this key; the services hold the private half.
[sealing]
public_key = "@SEAL_PUBLIC@"

[unsealing]
key_files = ["/etc/rusty-keys/unseal.key"]

[store]
url = "postgres://rusty_app@db:5432/rusty"
password_file = "/run/secrets/pg_app"
sslmode = "verify-full"
ca_bundle = "/etc/rusty/db-ca.pem"
