# Generated by setup.sh from templates/gc.toml.in. Edit the template and run setup.sh again, or this file (setup.sh never overwrites it).
# The gc service: its file accepts only the sections it uses (docs/docker.md).
hostname = "@MAIL_HOST@"
blob_dir = "/var/lib/rusty/blobs"
gc_grace_seconds = 604800

# The periodic check of every domain's DNS records is queued from here; the outbound service runs the checks.
[dns_check]
enabled = true

# A tenant's bucket keys are sealed to this service's key (docs/blob-stores.md): every service that opens message bodies holds the private half.
[unsealing]
key_files = ["/etc/rusty-keys/unseal.key"]

[store]
url = "postgres://rusty_gc@db:5432/rusty"
password_file = "/run/secrets/pg_gc"
sslmode = "verify-full"
ca_bundle = "/etc/rusty/db-ca.pem"

# The Prometheus endpoint (./setup.sh --metrics-allow CIDR): only the metrics network (the admin web, the central endpoint, reads it from there) may read it.
#METRICS [metrics]
#METRICS listen = "0.0.0.0:9100"
#METRICS allowed_peers = ["10.79.0.0/24"]
