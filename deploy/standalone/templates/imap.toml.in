# Generated by setup.sh from templates/imap.toml.in. Edit the template and run setup.sh again, or this file (setup.sh never overwrites it).
# The imap service: its file accepts only the sections it uses (docs/docker.md).
hostname = "@MAIL_HOST@"
blob_dir = "/var/lib/rusty/blobs"

[tls]
cert_file = "/etc/rusty-tls/cert.pem"
key_file = "/etc/rusty-tls/key.pem"

[imap]
listen_143 = "0.0.0.0:1143"
listen_993 = "0.0.0.0:1993"
proxy_protocol = true
trusted_proxies = ["10.77.0.2/32", "127.0.0.1/32"]

# A tenant's bucket keys are sealed to this service's key (docs/blob-stores.md): every service that opens message bodies holds the private half.
[unsealing]
key_files = ["/etc/rusty-keys/unseal.key"]

[store]
url = "postgres://rusty_imap@db:5432/rusty"
password_file = "/run/secrets/pg_imap"
sslmode = "verify-full"
ca_bundle = "/etc/rusty/db-ca.pem"

# The Prometheus endpoint (./setup.sh --monitoring): only the Prometheus of the monitoring profile may scrape it.
#MONITORING [metrics]
#MONITORING listen = "0.0.0.0:9100"
#MONITORING allowed_peers = ["10.79.0.2/32"]
