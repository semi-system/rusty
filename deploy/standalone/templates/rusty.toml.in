# Generated by setup.sh from templates/rusty.toml.in. Edit the template and run setup.sh again, or this file (setup.sh never overwrites it).
hostname = "@MAIL_HOST@"
blob_dir = "/var/lib/rusty/blobs"
gc_grace_seconds = 604800

# The edge (HAProxy) terminates TLS on 465 and 993 and passes 25, 587 and 143 through; every connection starts with a PROXY v2 header from the edge only.
# The STARTTLS ports use the certificate cert-sync copies from the edge (docs/acme.md); the service reloads it when the files change.
[tls]
cert_file = "/etc/rusty-tls/cert.pem"
key_file = "/etc/rusty-tls/key.pem"

[smtp]
listen_25 = "0.0.0.0:2525"
listen_587 = "0.0.0.0:5587"
listen_465 = "0.0.0.0:4465"
proxy_protocol = true
trusted_proxies = ["10.77.0.2/32", "127.0.0.1/32"]   # the edge; and loopback, from where `rusty healthcheck` probes

[imap]
listen_143 = "0.0.0.0:1143"
listen_993 = "0.0.0.0:1993"
proxy_protocol = true
trusted_proxies = ["10.77.0.2/32", "127.0.0.1/32"]   # the edge; and loopback, from where `rusty healthcheck` probes

[outbound]
dkim_dir = "/var/lib/rusty/dkim"
public_ips = ["@PUBLIC_IP@"]

[dns_check]
enabled = true

# Secrets typed into the admin web (DKIM keys, relay passwords) are sealed to this key; only this service holds the private half.
[sealing]
public_key = "@SEAL_PUBLIC@"

[unsealing]
key_files = ["/etc/rusty-keys/unseal.key"]

[store]
url = "postgres://rusty_app@db:5432/rusty"
password_file = "/run/secrets/pg_app"
sslmode = "verify-full"
ca_bundle = "/etc/rusty/db-ca.pem"
