# Generated by setup.sh from templates/submission.toml.in. Edit the template and run setup.sh again, or this file (setup.sh never overwrites it).
# The submission service: its file accepts only the sections it uses (docs/docker.md).
hostname = "@MAIL_HOST@"
blob_dir = "/var/lib/rusty/blobs"

# 587 is passed through, 465 is ended by the edge; both start with a PROXY v2 header from the edge.
[tls]
cert_file = "/etc/rusty-tls/cert.pem"
key_file = "/etc/rusty-tls/key.pem"

[smtp]
listen_587 = "0.0.0.0:5587"
listen_465 = "0.0.0.0:4465"
proxy_protocol = true
trusted_proxies = ["10.77.0.2/32", "127.0.0.1/32"]

[outbound]
public_ips = ["@PUBLIC_IP@"]

# A tenant's bucket keys are sealed to this service's key (docs/blob-stores.md): every service that opens message bodies holds the private half.
[unsealing]
key_files = ["/etc/rusty-keys/unseal.key"]

[store]
url = "postgres://rusty_submission@db:5432/rusty"
password_file = "/run/secrets/pg_submission"
sslmode = "verify-full"
ca_bundle = "/etc/rusty/db-ca.pem"

# The Prometheus endpoint (./setup.sh --monitoring): only the Prometheus of the monitoring profile may scrape it.
#MONITORING [metrics]
#MONITORING listen = "0.0.0.0:9100"
#MONITORING allowed_peers = ["10.79.0.2/32"]
