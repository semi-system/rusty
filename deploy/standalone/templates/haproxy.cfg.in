# Generated by setup.sh from templates/haproxy.cfg.in. HAProxy is the edge: it ends TLS on 465, 993 and the admin host, passes 25, 587 and 143 through, and tells
# the services the client address with PROXY protocol v2 (docs/acme.md). Lines starting with #ACME are for certificates obtained over ACME (HTTP-01),
# lines starting with #SELF for the self-signed certificates setup.sh made (a test installation that the internet cannot reach); setup.sh keeps one kind.
global
    maxconn 4096
#ACME    expose-experimental-directives
    log stdout format raw local0
    ssl-server-verify required
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets strict-sni
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
#ACME    # The runtime socket cert-sync reads the certificate from: group-only access (the sidecar joins the group).
#ACME    stats socket /run/ha/admin.sock mode 660 level admin

# Docker's embedded resolver: the names of the services, and every replica of one.
resolvers docker
    nameserver dns 127.0.0.11:53
    resolve_retries 3
    timeout resolve 1s
    timeout retry 1s
    hold valid 5s
    hold other 5s
    hold nx 3s
    accepted_payload_size 4096

defaults
    log global
    mode tcp
    option dontlognull
    timeout connect 3s
    timeout client 5m
    timeout server 5m

#ACME acme letsencrypt
#ACME     directory @ACME_DIRECTORY@
#ACME     contact @CONTACT@
#ACME     challenge HTTP-01
#ACME     keytype ECDSA
#ACME     account-key /var/lib/haproxy/acme/account.key
#ACME     map virt@acme
#ACME
#ACME crt-store certs
#ACME     crt-base /var/lib/haproxy/certs
#ACME     key-base /var/lib/haproxy/certs
#ACME     load crt "mail.pem" acme letsencrypt domains "@MAIL_HOST@"
#ACME     load crt "admin.pem" acme letsencrypt domains "@ADMIN_HOST@"
#WEBMAIL #ACME     load crt "webmail.pem" acme letsencrypt domains "@WEBMAIL_HOST@"

frontend http_in
    mode http
    bind :80
    timeout http-request 10s
#ACME     http-request return status 200 content-type text/plain lf-string "%[path,field(-1,/)].%[path,field(-1,/),map(virt@acme)]" if { path_beg /.well-known/acme-challenge/ }
    # Mail client auto-setup (Thunderbird): http://autoconfig.<domain>/mail/config-v1.1.xml goes to the admin service, which answers that one path and nothing else; every other request is sent to HTTPS.
    acl autoconfig_host hdr(host),lower,field(1,:) -m beg autoconfig.
    acl autoconfig_path path -m str /mail/config-v1.1.xml
    http-request redirect scheme https code 308 unless autoconfig_host autoconfig_path METH_GET
    use_backend be_admin if autoconfig_host autoconfig_path METH_GET

frontend smtp_in
    bind :25
    default_backend be_smtp

frontend submission_in
    bind :587
    default_backend be_submission

frontend smtps_in
#ACME     bind :465 ssl crt "@certs/mail.pem"
#SELF     bind :465 ssl crt /var/lib/haproxy/certs/mail.pem
    default_backend be_smtps

frontend imap_in
    bind :143
    default_backend be_imap

frontend imaps_in
#ACME     bind :993 ssl crt "@certs/mail.pem"
#SELF     bind :993 ssl crt /var/lib/haproxy/certs/mail.pem
    default_backend be_imaps

# POP3 (docs/design-pop3.md): a listener of the IMAP service, always open here; whether it answers is a switch in the database (the admin web, docs/design-protocols.md).
frontend pop3_in
    bind :110
    default_backend be_pop3

# ManageSieve (docs/design-sieve.md): the filters of a person, put by a mail client; STARTTLS, passed through like 143 and 110.
frontend sieve_in
    bind :4190
    default_backend be_sieve

frontend pop3s_in
#ACME     bind :995 ssl crt "@certs/mail.pem"
#SELF     bind :995 ssl crt /var/lib/haproxy/certs/mail.pem
    default_backend be_pop3s

# HTTPS on 443 for two host names. The admin host: from the allow-listed networks only. The mail host: only the auto-setup of mail clients that need HTTPS (Outlook's Autodiscover, and
# the profile Apple Mail installs, and the Mozilla answer again), which the admin service answers without a session; everything else on the mail host is refused. A tenant domain's
# own `autodiscover.<domain>` has no certificate here: Outlook then follows the `_autodiscover._tcp.<domain>` SRV record to the mail host (docs/first-mail.md).
frontend admin_https
    mode http
#ACME     bind :443 ssl crt "@certs/admin.pem" crt "@certs/mail.pem"@WEBMAIL_CRT@ alpn h2,http/1.1
#SELF     bind :443 ssl crt /var/lib/haproxy/certs/admin.pem crt /var/lib/haproxy/certs/mail.pem@WEBMAIL_CRT@ alpn h2,http/1.1
    timeout http-request 10s
#WEBMAIL     acl webmail_host hdr(host),lower,field(1,:) -m str @WEBMAIL_HOST@
#WEBMAIL     http-request allow if webmail_host
#WEBMAIL     use_backend be_webmail if webmail_host
    acl admin_host hdr(host),lower,field(1,:) -m str @ADMIN_HOST@
    acl admin_net  src @ADMIN_ALLOW@
    acl mail_host  hdr(host),lower,field(1,:) -m str @MAIL_HOST@
    acl setup_path path -i -m str /autodiscover/autodiscover.xml
    acl setup_path path -m str /mail/config.mobileconfig
    acl setup_path path -m str /mail/config-v1.1.xml
    acl setup_path path -m str /.well-known/autoconfig/mail/config-v1.1.xml
    acl setup_path path -i -m str /autodiscover/autodiscover.json
    acl setup_method method GET POST
    http-request allow if mail_host setup_path setup_method
    http-request deny deny_status 421 unless admin_host
    http-request deny deny_status 403 unless admin_net
    use_backend be_admin if mail_host setup_path setup_method
    default_backend be_admin

# The services by NAME, through Docker's resolver, so replicas (`docker compose up -d --scale smtp-in=3`) join and leave by themselves: each A record of the name is one server of the
# template, re-resolved every few seconds, and a replica that does not accept a connection is taken out (`check`). The edge shares only the `app` network with them, so the names
# resolve to addresses on it, and the PROXY header is accepted from the edge's address on this network only (the edge is the one container with a fixed address).
backend be_smtp
    server-template smtp-in 1-8 smtp-in:2525 resolvers docker init-addr none check inter 5s send-proxy-v2

backend be_submission
    server-template submission 1-8 submission:5587 resolvers docker init-addr none check inter 5s send-proxy-v2

backend be_smtps
    server-template submission 1-8 submission:4465 resolvers docker init-addr none check inter 5s send-proxy-v2

backend be_imap
    server-template imap 1-8 imap:1143 resolvers docker init-addr none check inter 5s send-proxy-v2

backend be_imaps
    server-template imap 1-8 imap:1993 resolvers docker init-addr none check inter 5s send-proxy-v2

backend be_pop3
    server-template imap 1-8 imap:1110 resolvers docker init-addr none check inter 5s send-proxy-v2

backend be_sieve
    server-template imap 1-8 imap:4190 resolvers docker init-addr none check inter 5s send-proxy-v2

backend be_pop3s
    server-template imap 1-8 imap:1995 resolvers docker init-addr none check inter 5s send-proxy-v2

backend be_admin
    mode http
    server-template admin 1-4 admin:8080 resolvers docker init-addr none check inter 5s send-proxy-v2

#WEBMAIL backend be_webmail
#WEBMAIL     mode http
#WEBMAIL     server-template webmail 1-4 webmail:8090 resolvers docker init-addr none check inter 5s send-proxy-v2
