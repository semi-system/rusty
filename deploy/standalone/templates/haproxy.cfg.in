# Generated by setup.sh from templates/haproxy.cfg.in. HAProxy is the edge: it gets the certificates (ACME HTTP-01), ends TLS on 465, 993 and the admin host,
# passes 25, 587 and 143 through, and tells the services the client address with PROXY protocol v2 (docs/acme.md).
global
    maxconn 4096
    expose-experimental-directives
    log stdout format raw local0
    ssl-server-verify required
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets strict-sni
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    # The runtime socket cert-sync reads the certificate from: group-only access (the sidecar joins the group).
    stats socket /run/ha/admin.sock mode 660 level admin

defaults
    log global
    mode tcp
    option dontlognull
    timeout connect 3s
    timeout client 5m
    timeout server 5m

acme letsencrypt
    directory @ACME_DIRECTORY@
    contact @CONTACT@
    challenge HTTP-01
    keytype ECDSA
    account-key /var/lib/haproxy/acme/account.key
    map virt@acme

crt-store certs
    crt-base /var/lib/haproxy/certs
    key-base /var/lib/haproxy/certs
    load crt "mail.pem" acme letsencrypt domains "@MAIL_HOST@"
    load crt "admin.pem" acme letsencrypt domains "@ADMIN_HOST@"

frontend http_in
    mode http
    bind :80
    timeout http-request 10s
    http-request return status 200 content-type text/plain lf-string "%[path,field(-1,/)].%[path,field(-1,/),map(virt@acme)]" if { path_beg /.well-known/acme-challenge/ }
    http-request redirect scheme https code 308

frontend smtp_in
    bind :25
    default_backend be_smtp

frontend submission_in
    bind :587
    default_backend be_submission

frontend smtps_in
    bind :465 ssl crt "@certs/mail.pem"
    default_backend be_smtps

frontend imap_in
    bind :143
    default_backend be_imap

frontend imaps_in
    bind :993 ssl crt "@certs/mail.pem"
    default_backend be_imaps

# The admin host: HTTPS only, from the allow-listed networks only.
frontend admin_https
    mode http
    bind :443 ssl crt "@certs/admin.pem" alpn h2,http/1.1
    timeout http-request 10s
    acl admin_host hdr(host),lower,field(1,:) -m str @ADMIN_HOST@
    acl admin_net  src @ADMIN_ALLOW@
    http-request deny deny_status 421 unless admin_host
    http-request deny deny_status 403 unless admin_net
    default_backend be_admin

backend be_smtp
    server mail 10.77.0.10:2525 send-proxy-v2

backend be_submission
    server mail 10.77.0.10:5587 send-proxy-v2

backend be_smtps
    server mail 10.77.0.10:4465 send-proxy-v2

backend be_imap
    server mail 10.77.0.10:1143 send-proxy-v2

backend be_imaps
    server mail 10.77.0.10:1993 send-proxy-v2

backend be_admin
    mode http
    server admin 10.77.0.11:8080 check
