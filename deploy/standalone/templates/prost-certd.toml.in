# Generated by deploy/swarm/stack.sh from templates/prost-certd.toml.in. prost-certd owns the ACME account and the certificates (docs/design-prost-edge.md): it answers HTTP-01 on a private port that
# the edge routes /.well-known/acme-challenge/ to, writes each certificate into an immutable version directory (`current` is a symlink) and gives the new one to the edge through its admin socket,
# with no restart and no cut sessions. One group, `edge`, holds the two names: a certificate with both in it, for the mail ports and for the admin web.
directory_url = "@ACME_DIRECTORY@"
contact = "mailto:@CONTACT@"
terms_agreed = true
state_dir = "/var/lib/prost-certd"
certificates_dir = "/certificates"
admin_socket = "/run/prost/admin.sock"
challenge_address = "0.0.0.0:8088"
# Renew a month before it ends; ask again after five minutes when an order fails.
renew_before_seconds = 2592000
retry_seconds = 300
order_timeout_seconds = 180
readiness_min_validity_seconds = 60
delivery_retry_seconds = 10

[[certificates]]
id = "edge"
domains = ["@MAIL_HOST@", "@ADMIN_HOST@"]
listeners = ["smtps", "imaps", "pop3s", "admin"]
# Keep the strict SNI allow-list of each listener as it is (the names are in the edge's configuration already).
add_sni_names = false
