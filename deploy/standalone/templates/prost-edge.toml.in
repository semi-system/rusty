# Generated by deploy/swarm/stack.sh from templates/prost-edge.toml.in. Prost is the edge here (docs/design-prost-edge.md): it ends TLS on 465, 993, 995 and 443, passes 25, 587, 143, 110 and 4190
# through, and tells the services the client address with PROXY protocol v2, as HAProxy does. Lines starting with #CERTD are for certificates that prost-certd obtains over ACME (HTTP-01 on port 80).
# The ports below are the container's (the host ports are published by the stack file).
schema_version = 1

[runtime]
admin_socket = "/run/prost/admin.sock"
artifact_dir = "/var/lib/prost/artifacts"
# A change is a rolling update (the new worker takes new connections, the old one keeps its own): mail sessions are not cut.
reload_mode = "rolling"
max_connections = 4096
drain_seconds = 0
metrics_address = "127.0.0.1:9090"
#S3 [runtime.s3]
#S3 region = "@CERT_S3_REGION@"
#S3 endpoint = "@CERT_S3_ENDPOINT@"
#S3 force_path_style = true
[runtime.access_log]
sink = "stdout"
format = "json"
queue_capacity = 2048

# ---- the services, by name: every task of one is a server (`tasks.<service>` answers with them all, and the answer is asked again when its time to live has passed) -----------------------------------
[upstreams.smtp]
send_proxy_v2 = true
connect_timeout_ms = 3000
idle_timeout_ms = 300000
write_timeout_ms = 30000
half_close_timeout_ms = 5000
health_interval_ms = 5000
# The probes: three failed ones in a row (15 s) take a task out, two good ones bring it back; the default of Prost is ONE failed probe, which under load (a busy task slow to accept) took the only admin task out and
# answered every request with 503.
# A refused or lost connection under load must not take a service out for good: without this block ONE failed forward ejects the endpoint until the next probe (a single admin task then answers 503 to everyone).
[upstreams.smtp.passive_health]
max_fails = @PASSIVE_FAILS@
fail_timeout_ms = 5000
[upstreams.smtp.dns]
authoritative_ttl = true
[upstreams.smtp.health_check]
fall = 3
rise = 2
protocol = "connect"
proxy_v2_command = "local"
[[upstreams.smtp.endpoints]]
id = "smtp-in"
address = "tasks.smtp-in:2525"

[upstreams.submission]
send_proxy_v2 = true
connect_timeout_ms = 3000
idle_timeout_ms = 300000
write_timeout_ms = 30000
half_close_timeout_ms = 5000
health_interval_ms = 5000
[upstreams.submission.passive_health]
max_fails = @PASSIVE_FAILS@
fail_timeout_ms = 5000
[upstreams.submission.dns]
authoritative_ttl = true
[upstreams.submission.health_check]
fall = 3
rise = 2
protocol = "connect"
proxy_v2_command = "local"
[[upstreams.submission.endpoints]]
id = "submission"
address = "tasks.submission:5587"

[upstreams.smtps]
send_proxy_v2 = true
connect_timeout_ms = 3000
idle_timeout_ms = 300000
write_timeout_ms = 30000
half_close_timeout_ms = 5000
health_interval_ms = 5000
[upstreams.smtps.passive_health]
max_fails = @PASSIVE_FAILS@
fail_timeout_ms = 5000
[upstreams.smtps.dns]
authoritative_ttl = true
[upstreams.smtps.health_check]
fall = 3
rise = 2
protocol = "connect"
proxy_v2_command = "local"
[[upstreams.smtps.endpoints]]
id = "submission-tls"
address = "tasks.submission:4465"

[upstreams.imap]
send_proxy_v2 = true
connect_timeout_ms = 3000
# IMAP IDLE may stay silent for longer than a mail submission can.
idle_timeout_ms = 0
write_timeout_ms = 30000
half_close_timeout_ms = 5000
health_interval_ms = 5000
[upstreams.imap.passive_health]
max_fails = @PASSIVE_FAILS@
fail_timeout_ms = 5000
[upstreams.imap.dns]
authoritative_ttl = true
[upstreams.imap.health_check]
fall = 3
rise = 2
protocol = "connect"
proxy_v2_command = "local"
[[upstreams.imap.endpoints]]
id = "imap"
address = "tasks.imap:1143"

[upstreams.imaps]
send_proxy_v2 = true
connect_timeout_ms = 3000
idle_timeout_ms = 0
write_timeout_ms = 30000
half_close_timeout_ms = 5000
health_interval_ms = 5000
[upstreams.imaps.passive_health]
max_fails = @PASSIVE_FAILS@
fail_timeout_ms = 5000
[upstreams.imaps.dns]
authoritative_ttl = true
[upstreams.imaps.health_check]
fall = 3
rise = 2
protocol = "connect"
proxy_v2_command = "local"
[[upstreams.imaps.endpoints]]
id = "imap-tls"
address = "tasks.imap:1993"

# POP3 is a listener of the IMAP service (docs/design-pop3.md); whether it answers is a switch in the database.
[upstreams.pop3]
send_proxy_v2 = true
connect_timeout_ms = 3000
idle_timeout_ms = 600000
write_timeout_ms = 30000
half_close_timeout_ms = 5000
health_interval_ms = 5000
[upstreams.pop3.passive_health]
max_fails = @PASSIVE_FAILS@
fail_timeout_ms = 5000
[upstreams.pop3.dns]
authoritative_ttl = true
[upstreams.pop3.health_check]
fall = 3
rise = 2
protocol = "connect"
proxy_v2_command = "local"
[[upstreams.pop3.endpoints]]
id = "pop3"
address = "tasks.imap:1110"

# ManageSieve is a listener of the IMAP service too (docs/design-sieve.md).
[upstreams.sieve]
send_proxy_v2 = true
connect_timeout_ms = 3000
idle_timeout_ms = 600000
write_timeout_ms = 30000
half_close_timeout_ms = 5000
health_interval_ms = 5000
[upstreams.sieve.passive_health]
max_fails = @PASSIVE_FAILS@
fail_timeout_ms = 5000
[upstreams.sieve.dns]
authoritative_ttl = true
[upstreams.sieve.health_check]
fall = 3
rise = 2
protocol = "connect"
proxy_v2_command = "local"
[[upstreams.sieve.endpoints]]
id = "sieve"
address = "tasks.imap:4190"

[upstreams.pop3s]
send_proxy_v2 = true
connect_timeout_ms = 3000
idle_timeout_ms = 600000
write_timeout_ms = 30000
half_close_timeout_ms = 5000
health_interval_ms = 5000
[upstreams.pop3s.passive_health]
max_fails = @PASSIVE_FAILS@
fail_timeout_ms = 5000
[upstreams.pop3s.dns]
authoritative_ttl = true
[upstreams.pop3s.health_check]
fall = 3
rise = 2
protocol = "connect"
proxy_v2_command = "local"
[[upstreams.pop3s.endpoints]]
id = "pop3-tls"
address = "tasks.imap:1995"

# The admin web: the edge ends TLS and sends the PROXY header ([admin] proxy_protocol), so the audit log and the sign-in throttle see the client's address.
[upstreams.web]
#ADMINPROXY send_proxy_v2 = true
connect_timeout_ms = 3000
health_interval_ms = 5000
[upstreams.web.passive_health]
max_fails = @PASSIVE_FAILS@
fail_timeout_ms = 5000
[upstreams.web.dns]
authoritative_ttl = true
[upstreams.web.health_check]
fall = 3
rise = 2
protocol = "connect"
#ADMINPROXY proxy_v2_command = "local"
[[upstreams.web.endpoints]]
id = "admin"
address = "tasks.admin:8080"

#WEBMAIL # The webmail (docs/design-webmail.md): the edge ends TLS and sends the PROXY header ([webmail] proxy_protocol), so the sign-in throttle and the audit see the client's address.
#WEBMAIL [upstreams.webmail]
#WEBMAIL send_proxy_v2 = true
#WEBMAIL connect_timeout_ms = 3000
#WEBMAIL health_interval_ms = 5000
#WEBMAIL [upstreams.webmail.passive_health]
#WEBMAIL max_fails = @PASSIVE_FAILS@
#WEBMAIL fail_timeout_ms = 5000
#WEBMAIL [upstreams.webmail.dns]
#WEBMAIL authoritative_ttl = true
#WEBMAIL [upstreams.webmail.health_check]
#WEBMAIL fall = 3
#WEBMAIL rise = 2
#WEBMAIL protocol = "connect"
#WEBMAIL proxy_v2_command = "local"
#WEBMAIL [[upstreams.webmail.endpoints]]
#WEBMAIL id = "webmail"
#WEBMAIL address = "tasks.webmail:8090"

#DAV # Calendars and contacts (docs/design-caldav-carddav.md): the edge ends TLS and sends the PROXY header ([dav] proxy_protocol); the routes of the mail host to it are generated below.
#DAV [upstreams.dav]
#DAV send_proxy_v2 = true
#DAV connect_timeout_ms = 3000
#DAV health_interval_ms = 5000
#DAV [upstreams.dav.passive_health]
#DAV max_fails = @PASSIVE_FAILS@
#DAV fail_timeout_ms = 5000
#DAV [upstreams.dav.dns]
#DAV authoritative_ttl = true
#DAV [upstreams.dav.health_check]
#DAV fall = 3
#DAV rise = 2
#DAV protocol = "connect"
#DAV proxy_v2_command = "local"
#DAV [[upstreams.dav.endpoints]]
#DAV id = "dav"
#DAV address = "tasks.dav:8091"

#CERTD [[upstreams.acme.endpoints]]
#CERTD id = "certd"
#CERTD address = "certd:8088"

# ---- the mail ports -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
[[listeners]]
id = "smtp"
address = "0.0.0.0:10025"
protocol = "tcp"
upstream = "smtp"
max_connections_per_ip = @MAX_PER_IP@
client_write_timeout_ms = 30000
[[listeners.plugins]]
name = "connection_rate"
config = {connections_per_second=@CONN_RATE@, burst=@CONN_BURST@, max_keys=100000, idle_timeout_ms=30000}

[[listeners]]
id = "submission"
address = "0.0.0.0:10587"
protocol = "tcp"
upstream = "submission"
max_connections_per_ip = @MAX_PER_IP@
client_write_timeout_ms = 30000

[[listeners]]
id = "imap"
address = "0.0.0.0:10143"
protocol = "tcp"
upstream = "imap"
max_connections_per_ip = @MAX_PER_IP@
client_write_timeout_ms = 30000

[[listeners]]
id = "pop3"
address = "0.0.0.0:10110"
protocol = "tcp"
upstream = "pop3"
max_connections_per_ip = @MAX_PER_IP@
client_write_timeout_ms = 30000

[[listeners]]
id = "sieve"
address = "0.0.0.0:14190"
protocol = "tcp"
upstream = "sieve"
max_connections_per_ip = @MAX_PER_IP@
client_write_timeout_ms = 30000

[[listeners]]
id = "smtps"
address = "0.0.0.0:10465"
protocol = "tcp"
upstream = "smtps"
max_connections_per_ip = @MAX_PER_IP@
client_write_timeout_ms = 30000
tls_handshake_timeout_ms = 5000
[listeners.tls]
certificate = "@MAIL_CERT@"
private_key = "@MAIL_KEY@"
reject_unknown_sni = true
[[listeners.tls.certificates]]
server_names = ["@MAIL_HOST@"]
certificate = "@MAIL_CERT@"
private_key = "@MAIL_KEY@"
[listeners.tls.policy]
min_version = "tls12"
session_resumption = false

[[listeners]]
id = "imaps"
address = "0.0.0.0:10993"
protocol = "tcp"
upstream = "imaps"
max_connections_per_ip = @MAX_PER_IP@
client_write_timeout_ms = 30000
tls_handshake_timeout_ms = 5000
[listeners.tls]
certificate = "@MAIL_CERT@"
private_key = "@MAIL_KEY@"
reject_unknown_sni = true
[[listeners.tls.certificates]]
server_names = ["@MAIL_HOST@"]
certificate = "@MAIL_CERT@"
private_key = "@MAIL_KEY@"
[listeners.tls.policy]
min_version = "tls12"
session_resumption = false

[[listeners]]
id = "pop3s"
address = "0.0.0.0:10995"
protocol = "tcp"
upstream = "pop3s"
max_connections_per_ip = @MAX_PER_IP@
client_write_timeout_ms = 30000
tls_handshake_timeout_ms = 5000
[listeners.tls]
certificate = "@MAIL_CERT@"
private_key = "@MAIL_KEY@"
reject_unknown_sni = true
[[listeners.tls.certificates]]
server_names = ["@MAIL_HOST@"]
certificate = "@MAIL_CERT@"
private_key = "@MAIL_KEY@"
[listeners.tls.policy]
min_version = "tls12"
session_resumption = false

# ---- HTTPS on 443 for two host names -----------------------------------------------------------------------------------------------------------------------------------------------------------
# The admin host: from the allow-listed networks only. The mail host: only the auto-setup of mail clients that need HTTPS (Outlook's Autodiscover, the profile Apple Mail installs, the Mozilla answer
# again), which the admin service answers without a session; nothing else on the mail host is routed. Any other host name is refused with 421.
[[listeners]]
id = "admin"
address = "0.0.0.0:10443"
protocol = "http"
max_connections_per_ip = 100
client_write_timeout_ms = 30000
header_read_timeout_ms = 10000
[[listeners.plugins]]
name = "host_acl"
config = {hosts=["@ADMIN_HOST@", "@MAIL_HOST@"@WEBMAIL_ACL@], status=421}
[listeners.http2_settings]
header_read_timeout_ms = 10000
[listeners.tls]
certificate = "@ADMIN_CERT@"
private_key = "@ADMIN_KEY@"
reject_unknown_sni = true
[[listeners.tls.certificates]]
server_names = ["@ADMIN_HOST@"]
certificate = "@ADMIN_CERT@"
private_key = "@ADMIN_KEY@"
[[listeners.tls.certificates]]
server_names = ["@MAIL_HOST@"]
certificate = "@MAIL_CERT@"
private_key = "@MAIL_KEY@"
#WEBMAIL [[listeners.tls.certificates]]
#WEBMAIL server_names = ["@WEBMAIL_HOST@"]
#WEBMAIL certificate = "@WEBMAIL_CERT@"
#WEBMAIL private_key = "@WEBMAIL_KEY@"
[listeners.tls.policy]
min_version = "tls12"
session_resumption = false

#WEBMAIL # The webmail host: open to everyone (a person signs in there); the webmail guards its own sessions.
#WEBMAIL [[listeners.routes]]
#WEBMAIL host = "@WEBMAIL_HOST@"
#WEBMAIL path_prefix = "/"
#WEBMAIL upstream = "webmail"

[[listeners.routes]]
host = "@ADMIN_HOST@"
path_prefix = "/"
upstream = "web"
[[listeners.routes.plugins]]
name = "ip_acl"
hooks = ["request_headers"]
config = {require_allowlist=true, allow=[@ADMIN_ALLOW_TOML@]}

@SETUP_ROUTES@
# ---- port 80: the challenge of the certificate authority, the Thunderbird auto-setup, and HTTPS for everything else ---------------------------------------------------------------------------
[[listeners]]
id = "http"
address = "0.0.0.0:10080"
protocol = "http"
header_read_timeout_ms = 10000
#CERTD [[listeners.routes]]
#CERTD path_prefix = "/.well-known/acme-challenge/"
#CERTD priority = 100
#CERTD upstream = "acme"
# Mail client auto-setup (Thunderbird): http://autoconfig.<domain>/mail/config-v1.1.xml goes to the admin service, which answers that one path and nothing else.
[[listeners.routes]]
path_prefix = "/mail/config-v1.1.xml"
priority = 50
methods = ["GET"]
upstream = "web"
[[listeners.routes]]
path_prefix = "/"
upstream = "web"
[[listeners.routes.plugins]]
name = "rewrite"
config = {rules=[{action="redirect", to="https://$host$request_uri", status=308, query="drop"}]}
