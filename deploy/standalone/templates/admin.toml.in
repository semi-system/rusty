# Generated by setup.sh from templates/admin.toml.in.
hostname = "@MAIL_HOST@"

[admin]
listen = "0.0.0.0:8080"
public_origin = "https://@ADMIN_HOST@"
public_ips = ["@PUBLIC_IP@"]
# Only the edge (and the container's own health probe) may connect: another container cannot reach the admin web directly and skip the edge's address allow-list.
allowed_peers = ["10.77.0.2/32", "127.0.0.1/32"]

[store]
# The admin web has a database role of its own: no mail tables, no reading of sealed secrets back (docs/postgres-production.md).
url = "postgres://rusty_admin@db:5432/rusty"
password_file = "/run/secrets/pg_admin"
sslmode = "verify-full"
ca_bundle = "/etc/rusty/db-ca.pem"

[sealing]
public_key = "@SEAL_PUBLIC@"
