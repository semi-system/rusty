# Generated by setup.sh from templates/admin.toml.in.
hostname = "@MAIL_HOST@"

[admin]
listen = "0.0.0.0:8080"
public_origin = "https://@ADMIN_HOST@"
public_ips = ["@PUBLIC_IP@"]
# Only the edge (and the container's own health probe) may connect: another container cannot reach the admin web directly and skip the edge's address allow-list.
allowed_peers = ["10.77.0.2/32", "127.0.0.1/32"]

[store]
# The admin web has a database role of its own: no mail tables, no reading of sealed secrets back (docs/postgres-production.md).
url = "postgres://rusty_admin@db:5432/rusty"
password_file = "/run/secrets/pg_admin"
sslmode = "verify-full"
ca_bundle = "/etc/rusty/db-ca.pem"

[sealing]
public_key = "@SEAL_PUBLIC@"

# The Prometheus endpoint (./setup.sh --metrics-allow CIDR): only the networks named there may scrape it.
#METRICS [metrics]
#METRICS listen = "0.0.0.0:9100"
#METRICS allowed_peers = [@METRICS_ALLOW@]
# The shared key-value store (./setup.sh --valkey): the sessions, the login throttle and the sending budget are then one for every replica.
#VALKEY [valkey]
#VALKEY host = "valkey"
#VALKEY tls = true
#VALKEY ca_bundle = "/etc/rusty/db-ca.pem"
#VALKEY username = "rusty_admin"
#VALKEY password_file = "/run/secrets/kv_admin"
#VALKEY key_prefix = "rusty:"
