# Generated by setup.sh from templates/pg_hba.conf.in. Who may connect to the database: an allow-list by SERVICE NAME and role. Everything else is rejected.
# Postgres looks the client's address up in the name service, finds the container name (Docker's own resolver answers `rusty-<service>-1.rusty_db`), checks that name
# resolves back to the same address, and compares it with the entries below. No addresses are fixed. The names follow compose.yaml (project `rusty`, network `db`,
# service names); add a line here when a service is given the database.
#
# TYPE   DATABASE  USER            ADDRESS                    METHOD
# the unix socket exists inside the container only (the healthcheck, `docker exec`); anyone who can run those already owns the host
local    all       postgres                                   trust
# the one-shot that creates the roles is the only client of the superuser
hostssl  rusty     postgres        rusty-db-init-1.rusty_db   scram-sha-256
# migrations
hostssl  rusty     rusty_migrator  rusty-migrate-1.rusty_db   scram-sha-256
# the admin web
hostssl  rusty     rusty_admin     rusty-admin-1.rusty_db     scram-sha-256
# the mail services, and the one-shot jobs that use the same role
hostssl  rusty     rusty_app       rusty-smtp-in-1.rusty_db     scram-sha-256
hostssl  rusty     rusty_app       rusty-submission-1.rusty_db  scram-sha-256
hostssl  rusty     rusty_app       rusty-imap-1.rusty_db        scram-sha-256
hostssl  rusty     rusty_app       rusty-outbound-1.rusty_db    scram-sha-256
hostssl  rusty     rusty_app       rusty-gc-1.rusty_db          scram-sha-256
hostssl  rusty     rusty_app       rusty-migrate-1.rusty_db     scram-sha-256
hostssl  rusty     rusty_app       rusty-blobs-init-1.rusty_db  scram-sha-256
# the operator's rustyctl: `docker compose run --rm --name rusty-ctl-1 ctl ...` (a name has to be given: the default one is random)
hostssl  rusty     rusty_app       rusty-ctl-1.rusty_db         scram-sha-256
# anything else: refused, whatever it knows
host     all       all             all                          reject
