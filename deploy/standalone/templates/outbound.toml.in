# Generated by setup.sh from templates/outbound.toml.in. Edit the template and run setup.sh again, or this file (setup.sh never overwrites it).
# The outbound service: its file accepts only the sections it uses (docs/docker.md).
hostname = "@MAIL_HOST@"
blob_dir = "/var/lib/rusty/blobs"

[outbound]
dkim_dir = "/var/lib/rusty/dkim"
public_ips = ["@PUBLIC_IP@"]

# A tenant's bucket keys are sealed to this service's key (docs/blob-stores.md): every service that opens message bodies holds the private half.
[unsealing]
key_files = ["/etc/rusty-keys/unseal.key"]

[store]
url = "postgres://rusty_outbound@db:5432/rusty"
password_file = "/run/secrets/pg_outbound"
sslmode = "verify-full"
ca_bundle = "/etc/rusty/db-ca.pem"

# The Prometheus endpoint (./setup.sh --metrics-allow CIDR): only the admin web (the central endpoint, 10.79.0.2) may read it.
#METRICS [metrics]
#METRICS listen = "0.0.0.0:9100"
#METRICS allowed_peers = ["10.79.0.2/32"]
