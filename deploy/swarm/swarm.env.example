# The inventory of a real swarm: copy it to swarm.env (kept by the operator, never in the repository) and edit it. See docs/design-swarm.md, section 5.
#   NODES entry: name|transport|role|labels|public_address
#     transport: ssh:USER@HOST (a key; the user must be able to run docker) or docker:CONTAINER (the local test cluster)
#     role:      manager (exactly one: the single entrance) or worker
#     labels:    comma separated key=value: outbound=true on the node whose address mail leaves from, av=true where clamd runs
#     public_address: the address the other nodes reach this one at and, for the Manager, the one the public names point to
NODES=(
  "mail-1|ssh:ops@203.0.113.10|manager|outbound=true,av=true|203.0.113.10"
  # "mail-2|ssh:ops@203.0.113.11|worker||203.0.113.11"
)
# Encrypt the overlays of the stack (IPsec): the nodes must let protocol 50 (ESP) through between them.
ENCRYPTED=1
MIN_DOCKER_MAJOR=25

# The external PostgreSQL. The login (DB_ADMIN_USER) may create roles in DB_NAME; it stays with you (the file below is yours: keep it for manual backups and for repairs) and is used only by
# `rusty-swarm prepare db`. It is never put in the swarm. DB_HOSTADDR is optional (connect to that address, check the certificate for DB_HOST).
DB_HOST=db.example.org
DB_PORT=5432
DB_NAME=rusty
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD_FILE="$HOME/.rusty-swarm/db-admin.pw"
# DB_TLS=1                  # 1 (default): verified TLS with the system CAs; 0: a plain connection (trusted private network only)
# DB_CA=/path/to/ca.pem      # only when the database certificate is signed by a private CA


# The edge (docs/design-prost-edge.md). HAProxy is the default. Prost (github.com/semi-system/prost) can be the edge too:
#   EDGE=haproxy       (default)
#   EDGE=prost-pilot   a pilot: HAProxy keeps the real ports, Prost runs beside it on the ports PROST_PILOT_OFFSET above them (20025, 20587, 20143, 20110, 20465, 20993, 20995, 20443, 20080) with the
#                      same certificates (TLS_MODE=acme needs CERT_S3=1: `certs sync` keeps HAProxy's certificates in S3 and Prost reads them from there). Try a mail client on those ports.
#   EDGE=prost         Prost is the edge on the real ports; with TLS_MODE=acme prost-certd gets and renews the certificates. Stop HAProxy's ports first: it is a replacement, not a pilot.
# EDGE=haproxy
# PROST_PILOT_OFFSET=20000
# PROST_IMAGE=ghcr.io/semi-system/prost:latest      # the kit's images.lock pins it by digest; set this only to use another one
# The certificates in an S3 bucket meant for administration, NOT the bucket of the mail (default: the stack's own S3, bucket `certs`; another S3 by the four variables below).
# CERT_S3=1
# CERT_S3_BUCKET=certs
# CERT_S3_ENDPOINT=https://s3.example.org
# CERT_S3_REGION=us-east-1
# CERT_S3_ACCESS_KEY=...
# CERT_S3_SECRET_KEY_FILE="$HOME/.rusty-swarm/cert-s3.key"

# ADMIN_PROXY=1  the edge sends the PROXY header to the admin web and the admin web reads it (the audit log and the sign-in throttle then see the client's address,
#                not the edge's). Needs the admin image of this kit's release: an older admin refuses the key. Default 0 until the images are published.

# PROST_MAX_PER_IP=50  PROST_CONN_RATE=10  PROST_CONN_BURST=100   what one client address may do at the Prost edge: concurrent connections on each listener, and for SMTP new connections per second
#                      (with a burst). HAProxy has no such limit at the edge. Raise them where many users share one address (an office behind NAT).
