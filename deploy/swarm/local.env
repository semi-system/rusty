# The inventory of the local test cluster (deploy/swarm/local-cluster.sh up): one Manager node that carries every label.
# Use it as: ./rusty-swarm --env local.env cluster check
NODES=(
  "rusty-m1|docker:rusty-m1|manager|outbound=true,av=true|"
)
ENCRYPTED=0

# The external PostgreSQL of the local cluster (./local-cluster.sh ext up): its login and CA are in ~/.rusty-swarm-local/ext (outside the repository).
DB_HOST=db.rusty.test
DB_HOSTADDR=172.30.0.10
DB_PORT=5432
DB_NAME=rusty
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD_FILE="$HOME/.rusty-swarm-local/ext/pg.pw"
DB_TLS=1
DB_CA="$HOME/.rusty-swarm-local/ext/ca.pem"   # the local database's CA is private
STATE_DIR="$HOME/.rusty-swarm-local/state"
