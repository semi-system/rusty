#!/usr/bin/env bash
# The deploy tool of the swarm form of Rusty Mail Server (docs/design-swarm.md, section 6). Run it from the operator's machine; it reaches every node of the inventory through a transport:
#   local              the machine this tool runs on (a single server: the user must be able to run docker, and to sudo for installing it)
#   ssh:USER@HOST      over SSH (a key; the node's `docker` must answer for that user)
#   docker:CONTAINER   a node that is a container of this machine (the local test cluster, deploy/swarm/local-cluster.sh)
#
#   ./rusty-swarm init                      with no swarm.env yet, in a terminal: a few questions (whiptail dialogs when the machine has whiptail, else plain prompts) write swarm.env and the
#                                                files of the passwords given (mode 0600), then the flow below runs
#   ./rusty-swarm [--env FILE] inventory    what the tool understood of the inventory
#   ./rusty-swarm [--env FILE] init [--yes]   the whole flow, automatic: Docker is installed where it is missing (get.docker.com, as root), a swarm that is already there is offered for
#                                                removal, then the check, the swarm, its proof and prepare db (the later steps join the chain as they are built); --yes answers the question with y
#   ./rusty-swarm [--env FILE] cluster check     what is wrong on the nodes (prints, changes nothing)
#   ./rusty-swarm [--env FILE] cluster install-docker   install Docker (get.docker.com, run as root) on the ssh nodes that have none (`init` does it by itself)
#   ./rusty-swarm [--env FILE] cluster init      start the swarm on the Manager, join the workers, set the labels (each part is skipped when it is already done)
#   ./rusty-swarm [--env FILE] cluster verify    nodes Ready and Active, and a throw-away overlay with one task per node: the tasks list each other, reach each other
#                                                (an encrypted overlay when the inventory says ENCRYPTED=1)
#   ./rusty-swarm [--env FILE] logs SERVICE [LINES]   the log of a service (for example admin: the setup token of the first start); verify: the greeting of ports 25, 587 and 143 through the edge
#   ./rusty-swarm [--env FILE] stack          print the stack file the next deploy would use
#   ./rusty-swarm [--env FILE] prepare secrets | prepare configs | migrate | deploy   the next steps of the flow, each repeatable: the swarm secrets (versioned names) and configs (named by the
#                                                hash of their content), the schema migration as a job, and the stack (the edge and the services)
#   ./rusty-swarm [--env FILE] prepare db       with the one login of the inventory (DB_ADMIN_USER), create the roles of the services in the external PostgreSQL (deploy/db/roles.sql), give each a random
#                                                password (kept in the state directory, mode 0600, for the next step) and prove that each of them can log in; run again, it changes no password
#
# The inventory is a file of shell variables (default: swarm.env next to this script, or $RUSTY_SWARM_ENV); `local.env` is the one of the local test cluster. It is the operator's own file and is never
# kept in the repository (swarm.env.example shows it):
#   NODES=("name|transport|role|labels|public_address" ...)    role: manager or worker; labels: comma-separated `key=value` (may be empty); public_address may be empty
#   ENCRYPTED=1                                                the overlays of the stack are encrypted (IPsec); needs the ESP protocol between the nodes
#   MIN_DOCKER_MAJOR=25                                        the oldest Docker major the stack is tested with
#   DB_HOST DB_PORT DB_NAME DB_ADMIN_USER DB_ADMIN_PASSWORD_FILE   the external PostgreSQL: where, which database (default rusty), the login for the preparation and the file that holds its password
#   DB_TLS=1                                     1 (default): TLS, the certificate checked (verify-full) against the system's CAs; 0: a plain connection (the services then run with sslmode = "disable" and
#                                                insecure_allow_unverified_tls = true, which they warn about at every start; for a database on a trusted private network only)
#   DB_CA                                        optional: the CA file, when the database's certificate is signed by a private CA; DB_HOSTADDR (optional) connects to that address while the certificate is checked against DB_HOST
#   STATE_DIR=$HOME/.rusty-swarm                where this tool keeps what it generates (the service passwords), mode 0700
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() { echo "rusty-swarm: $*" >&2; exit 1; }

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print } /^set / { exit }' "$0"; }
ENV_FILE="${RUSTY_SWARM_ENV:-$HERE/swarm.env}"
case "${1:-}" in -h|--help|help|"") usage; exit 0 ;; esac
if [ "${1:-}" = "--env" ]; then ENV_FILE="${2:?--env needs a file}"; shift 2; fi
NODES=(); ENCRYPTED=0; MIN_DOCKER_MAJOR=25
DB_HOST=""; DB_PORT=5432; DB_NAME=rusty; DB_ADMIN_USER=""; DB_ADMIN_PASSWORD_FILE=""; DB_CA=""; DB_TLS=1; DB_HOSTADDR=""; STATE_DIR="$HOME/.rusty-swarm"
MAIL_HOST=""; ADMIN_HOST=""; CONTACT=""; ADMIN_ALLOW=""
S3_ENDPOINT=""; S3_REGION=us-east-1; S3_BUCKET=rusty-mail; S3_ACCESS_KEY=""; S3_SECRET_KEY_FILE=""
if [ ! -r "$ENV_FILE" ]; then
  # No inventory: `init` asks for what it needs (a dialog, or plain prompts) and writes it; every other command needs the file.
  if [ "${1:-}" = init ] && { [ -t 0 ] || [ "${RUSTY_SWARM_UI:-}" = plain ]; }; then
    # shellcheck source=wizard.sh
    . "$HERE/wizard.sh"
    run_wizard "$ENV_FILE"
  else
    die "no inventory at $ENV_FILE (run `init` in a terminal to be asked, or copy swarm.env.example, or use --env local.env)"
  fi
fi
# shellcheck source=/dev/null
. "$ENV_FILE"
[ "${#NODES[@]}" -gt 0 ] || die "$ENV_FILE has no NODES"

# ---- the inventory ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------
node_field() { # NAME FIELD(1..5) -> value
  local line
  for line in "${NODES[@]}"; do
    if [ "${line%%|*}" = "$1" ]; then printf '%s\n' "$line" | cut -d'|' -f"$2"; return 0; fi
  done
  die "no node called $1"
}
node_names() { local line; for line in "${NODES[@]}"; do printf '%s\n' "${line%%|*}"; done; }
manager_name() {
  local n found=""
  for n in $(node_names); do
    if [ "$(node_field "$n" 3)" = manager ]; then [ -z "$found" ] || die "the inventory has more than one manager (this plan has one: the single entrance)"; found="$n"; fi
  done
  [ -n "$found" ] || die "the inventory has no manager"
  printf '%s\n' "$found"
}
validate_inventory() {
  local line n t r seen=" "
  for line in "${NODES[@]}"; do
    [ "$(printf '%s' "$line" | tr -cd '|' | wc -c)" = 4 ] || die "a NODES entry needs five fields name|transport|role|labels|public_address: $line"
    n="$(printf '%s' "$line" | cut -d'|' -f1)"; t="$(printf '%s' "$line" | cut -d'|' -f2)"; r="$(printf '%s' "$line" | cut -d'|' -f3)"
    [[ "$n" =~ ^[a-z][a-z0-9-]{0,30}$ ]] || die "node name '$n': lower case letters, digits and '-'"
    case "$seen" in *" $n "*) die "node '$n' appears twice" ;; esac
    seen="$seen$n "
    [[ "$t" =~ ^(local|ssh:[A-Za-z0-9._-]+@[A-Za-z0-9._:-]+|docker:[A-Za-z0-9._-]+)$ ]] || die "node $n: transport '$t' is local, ssh:USER@HOST or docker:CONTAINER"
    case "$r" in manager|worker) ;; *) die "node $n: role is manager or worker" ;; esac
  done
  manager_name >/dev/null
}

# ---- the transports --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# `on NAME COMMAND...` runs a command on a node; `dk NAME ARGS...` runs the node's docker.
on() {
  local n="$1" t; shift
  t="$(node_field "$n" 2)"
  case "$t" in
    ssh:*) ssh -o BatchMode=yes -o ConnectTimeout=10 "${t#ssh:}" "$(printf '%q ' "$@")" ;;
    docker:*) docker exec -i "${t#docker:}" "$@" ;;
    local) "$@" ;;
  esac
}
dk() { local n="$1"; shift; on "$n" docker "$@"; }

# What the tool understood of the inventory (and a proof that it is valid).
cmd_inventory() {
  local n
  echo "nodes:"
  for n in $(node_names); do printf '  %s  %s  %s  labels=%s  address=%s
' "$n" "$(node_field "$n" 2)" "$(node_field "$n" 3)" "$(node_field "$n" 4)" "$(node_field "$n" 5)"; done
  echo "mail host: ${MAIL_HOST:-(not set)}  admin host: ${ADMIN_HOST:-(not set)}  admin allow: ${ADMIN_ALLOW:-(not set)}"
  if [ -n "$DB_HOST" ]; then echo "PostgreSQL: external $DB_HOST:$DB_PORT/$DB_NAME as $DB_ADMIN_USER (tls=$DB_TLS)"; else echo "PostgreSQL: the default one, in the cluster"; fi
  if [ -n "$S3_ENDPOINT" ]; then echo "S3: external $S3_ENDPOINT bucket $S3_BUCKET"; else echo "S3: the default RustFS, in the cluster"; fi
}

# ---- cluster check ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------
BAD=0
ok() { printf '  ok    %s\n' "$*"; }
warn() { printf '  WARN  %s\n' "$*"; }
bad() { printf '  FAIL  %s\n' "$*"; BAD=1; }

check_node() {
  local n="$1" role v major mem free
  role="$(node_field "$n" 3)"
  echo "$n ($role, $(node_field "$n" 2)):"
  if ! on "$n" true >/dev/null 2>&1; then bad "cannot reach the node over its transport"; return; fi
  if v="$(dk "$n" version --format '{{.Server.Version}}' 2>/dev/null)" && [ -n "$v" ]; then
    major="${v%%.*}"
    if [[ "$major" =~ ^[0-9]+$ ]] && [ "$major" -ge "$MIN_DOCKER_MAJOR" ]; then ok "Docker $v"; else bad "Docker $v is older than $MIN_DOCKER_MAJOR (replicated-job, cap-drop on services and encrypted overlays are needed)"; fi
  else
    bad "docker does not answer on the node (the user must be able to run it)"; return
  fi
  if [ "$(on "$n" uname -m 2>/dev/null)" = x86_64 ]; then ok "x86_64 (the images are amd64 only)"; else bad "not x86_64: the images are amd64 only"; fi
  free="$(on "$n" df -Pk /var/lib/docker 2>/dev/null | awk 'NR == 2 { print int($4 / 1024 / 1024) }' || true)"
  if [[ "${free:-}" =~ ^[0-9]+$ ]]; then
    if [ "$free" -ge 10 ]; then ok "${free} GiB free for Docker"; else bad "only ${free} GiB free in /var/lib/docker (10 GiB at least)"; fi
  else
    warn "free disk space could not be read"
  fi
  mem="$(on "$n" awk '/MemTotal/ { print int($2 / 1024) }' /proc/meminfo 2>/dev/null || true)"
  if [[ "${mem:-}" =~ ^[0-9]+$ ]]; then
    if [ "$mem" -ge 2000 ]; then ok "${mem} MiB of memory"; else warn "${mem} MiB of memory: little for the services (docs/docker.md, limits.sh)"; fi
  fi
  # The kernel: IPVS balances the virtual IPs of services; IPsec (xfrm, esp4) encrypts an overlay.
  if on "$n" sh -c 'grep -q "^ip_vs" /proc/modules || [ -d /sys/module/ip_vs ]' >/dev/null 2>&1; then ok "IPVS (ip_vs) is available"; else warn "ip_vs is not loaded (swarm loads it when needed; the kernel must have it)"; fi
  if [ "$ENCRYPTED" = 1 ]; then
    if on "$n" sh -c 'grep -qE "^(esp4|xfrm_user)" /proc/modules || [ -d /sys/module/xfrm_user ] || [ -d /sys/module/esp4 ]' >/dev/null 2>&1; then ok "IPsec (xfrm, esp4) is available for the encrypted overlay"; else bad "ENCRYPTED=1 and the kernel shows no xfrm_user/esp4"; fi
  fi
  # Time: certificates and the database's clock logic care.
  if on "$n" sh -c 'command -v timedatectl >/dev/null' >/dev/null 2>&1; then
    if [ "$(on "$n" timedatectl show -p NTPSynchronized --value 2>/dev/null || true)" = yes ]; then ok "the clock is synchronised"; else bad "the clock is not NTP-synchronised"; fi
  else
    warn "no timedatectl: the clock's synchronisation could not be checked"
  fi
  local state; state="$(dk "$n" info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null || true)"
  case "$state" in
    active) ok "already in a swarm" ;;
    inactive) ok "not in a swarm yet" ;;
    *) warn "swarm state: ${state:-unknown}" ;;
  esac
  if [ "$role" = manager ]; then
    warn "from outside: 25 80 143 443 465 587 993 must reach this node; between nodes 2377/tcp 7946/tcp+udp 4789/udp (and protocol 50, ESP, when ENCRYPTED=1). A node cannot test its own firewall: 'cluster verify' proves the data path"
  fi
}

cmd_check() {
  local n
  for n in $(node_names); do check_node "$n"; done
  [ "$BAD" = 0 ] || die "cluster check: something is wrong (see FAIL above)"
  echo "cluster check: nothing is wrong that this check can see"
}

# ---- cluster init ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
node_state() { dk "$1" info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null || true; }

cmd_init() {
  local m n state addr token
  m="$(manager_name)"
  state="$(node_state "$m")"
  addr="$(node_addr "$m")"
  if [ "$state" != active ]; then
    dk "$m" swarm init --advertise-addr "$addr" >/dev/null
    echo "cluster init: $m started the swarm on $addr"
  else
    echo "cluster init: $m already has a swarm"
  fi
  token="$(dk "$m" swarm join-token -q worker)"
  for n in $(node_names); do
    [ "$n" = "$m" ] && continue
    if [ "$(node_state "$n")" != active ]; then
      dk "$n" swarm join --token "$token" "$addr:2377" >/dev/null
      echo "cluster init: $n joined"
    fi
  done
  cmd_label
}

# The address the other nodes reach a node at: the public address of the inventory when there is one, else what the node says its own address is.
node_addr() {
  local a; a="$(node_field "$1" 5)"
  if [ -n "$a" ]; then printf '%s\n' "$a"; return; fi
  a="$(dk "$1" info --format '{{.Swarm.NodeAddr}}' 2>/dev/null || true)"
  [ -n "$a" ] && [ "$a" != "<nil>" ] || a="$(on "$1" hostname -i 2>/dev/null | awk '{ print $1 }')"
  [ -n "$a" ] || die "no address for $1: give the public_address field"
  printf '%s\n' "$a"
}

cmd_label() {
  local m n l kv; m="$(manager_name)"
  for n in $(node_names); do
    l="$(node_field "$n" 4)"
    [ -n "$l" ] || continue
    for kv in ${l//,/ }; do
      [[ "$kv" =~ ^[a-z][a-z0-9_.-]*=[A-Za-z0-9_.-]+$ ]] || die "node $n: label '$kv' is key=value"
      dk "$m" node update --label-add "$kv" "$n" >/dev/null
    done
  done
  echo "cluster init: labels set"
}

# ---- cluster verify --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
cmd_verify() {
  local m svc=rs-verify-probe net=rs-verify-net opts=() total up n bad=0 line
  m="$(manager_name)"
  [ "$ENCRYPTED" != 1 ] || opts=(--opt encrypted)
  # Every node Ready and Active.
  total="$(node_names | wc -l)"
  while IFS= read -r line; do
    case "$line" in "Ready Active"*) ;; *) echo "  FAIL  a node is not Ready and Active: $line"; bad=1 ;; esac
  done < <(dk "$m" node ls --format '{{.Status}} {{.Availability}} {{.Hostname}}')
  [ "$(dk "$m" node ls -q | wc -l)" = "$total" ] || { echo "  FAIL  the swarm has $(dk "$m" node ls -q | wc -l) nodes, the inventory $total"; bad=1; }
  [ "$bad" = 0 ] || die "cluster verify: not every node is Ready and Active"
  echo "  ok    $total node(s) Ready and Active"
  probe_clean "$m" "$svc" "$net"
  dk "$m" network create -d overlay --attachable "${opts[@]}" "$net" >/dev/null
  dk "$m" service create --name "$svc" --mode global --network "$net" busybox sleep 3600 >/dev/null
  up=0
  for _ in $(seq 1 60); do
    up="$(dk "$m" service ps "$svc" --filter desired-state=running --format '{{.CurrentState}}' | grep -c '^Running' || true)"
    [ "$up" = "$total" ] && break
    sleep 2
  done
  if [ "$up" != "$total" ]; then dk "$m" service ps "$svc" --no-trunc >&2 || true; probe_clean "$m" "$svc" "$net"; die "cluster verify: only $up of $total probe tasks run"; fi
  echo "  ok    a task runs on every node"
  local c ips o oc oip
  for n in $(node_names); do
    c="$(dk "$n" ps -q --filter "name=$svc" | head -1)"
    [ -n "$c" ] || { echo "  FAIL  no probe task on $n"; bad=1; continue; }
    ips="$(dk "$n" exec "$c" nslookup "tasks.$svc" 2>/dev/null | awk '/^Address/ && $2 ~ /^[0-9]/ { print $2 }' | grep -vc '^127\.' || true)"
    if [ "$ips" = "$total" ]; then echo "  ok    on $n, tasks.$svc lists all $total task(s)"; else echo "  FAIL  on $n, tasks.$svc lists $ips address(es), expected $total"; bad=1; fi
    for o in $(node_names); do
      [ "$o" = "$n" ] && continue
      oc="$(dk "$o" ps -q --filter "name=$svc" | head -1)"; oip="$(dk "$o" exec "$oc" hostname -i | head -1)"
      if dk "$n" exec "$c" ping -c2 -W2 "$oip" >/dev/null 2>&1; then echo "  ok    $n reaches the task on $o"; else echo "  FAIL  $n cannot reach the task on $o ($oip)"; bad=1; fi
    done
  done
  probe_clean "$m" "$svc" "$net"
  [ "$bad" = 0 ] || die "cluster verify: the data path between the nodes does not work"
  echo "cluster verify: the cluster works${opts:+ (encrypted overlay)}"
}

probe_clean() { # the network cannot go while the last task is still shutting down: it is tried until it does
  local m="$1" svc="$2" net="$3" i
  dk "$m" service rm "$svc" >/dev/null 2>&1 || true
  for i in $(seq 1 30); do
    dk "$m" network rm "$net" >/dev/null 2>&1 && return 0
    dk "$m" network inspect "$net" >/dev/null 2>&1 || return 0
    sleep 2
  done
  die "the probe network $net could not be removed"
}

# ---- prepare db ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
SERVICE_ROLES=(app admin migrator smtp_in submission imap outbound gc)
POSTGRES_IMAGE="$(awk '$1 == "postgres:18" { print $2 }' "$HERE/../images.lock")"

secret_file() { printf '%s/secrets/pg_%s\n' "$STATE_DIR" "$1"; }

# Make the state directory and give every role a password that does not exist yet (a password that exists is never replaced).
make_passwords() {
  local r f
  umask 077
  mkdir -p "$STATE_DIR/secrets"; chmod 0700 "$STATE_DIR" "$STATE_DIR/secrets"
  for r in "${SERVICE_ROLES[@]}"; do
    f="$(secret_file "$r")"
    [ -s "$f" ] || od -An -N24 -tx1 /dev/urandom | tr -d ' \n' > "$f"
  done
}

# Run psql on the manager (the node reaches the database the way the services will). The first line of the standard input is the password, the rest is the SQL: the password is in no argument
# and no environment variable of a process on the node. $1 is the user, $2 the file with its password; the SQL comes from the standard input.
psql_as() {
  local m user="$1" pwfile="$2" ca="/tmp/rusty-swarm-ca.pem" conn mount=()
  m="$(manager_name)"
  conn="host=$DB_HOST port=$DB_PORT dbname=$DB_NAME user=$user"
  if [ "$DB_TLS" = 1 ]; then
    conn="$conn sslmode=verify-full"
    if [ -n "$DB_CA" ]; then
      conn="$conn sslrootcert=/ca.pem"
      on "$m" sh -c "umask 077; cat > $ca" < "$DB_CA"
      mount=(-v "$ca:/ca.pem:ro")
    else
      conn="$conn sslrootcert=system"
    fi
  else
    conn="$conn sslmode=disable"
  fi
  [ -z "$DB_HOSTADDR" ] || conn="$conn hostaddr=$DB_HOSTADDR"
  { cat "$pwfile"; echo; cat; } | dk "$m" run --rm -i --cap-drop ALL --security-opt no-new-privileges:true "${mount[@]}" --entrypoint sh "$POSTGRES_IMAGE" \
    -c 'IFS= read -r PGPASSWORD; export PGPASSWORD; exec psql -X -q -At -v ON_ERROR_STOP=1 "$0"' "$conn"
}

cmd_prepare_db() {
  local r f sql
  if [ -z "$DB_HOST" ]; then echo "prepare db: no DB_HOST: the default PostgreSQL of the stack is prepared once it runs (a later step)"; return 0; fi
  [ -n "$DB_HOST" ] && [ -n "$DB_ADMIN_USER" ] && [ -r "$DB_ADMIN_PASSWORD_FILE" ] || die "prepare db: the inventory needs DB_HOST, DB_ADMIN_USER and DB_ADMIN_PASSWORD_FILE (a readable file)"
  case "$DB_TLS" in
    1) ;;
    0) echo "WARNING: DB_TLS=0: the database connection is not encrypted (the services will run with insecure_allow_unverified_tls = true). Only for a trusted private network." >&2 ;;
    *) die "prepare db: DB_TLS is 1 or 0" ;;
  esac
  [ -z "$DB_CA" ] || [ -r "$DB_CA" ] || die "prepare db: DB_CA is not a readable file"
  [[ "$DB_PORT" =~ ^[0-9]+$ ]] && [[ "$DB_NAME" =~ ^[a-z][a-z0-9_]{0,62}$ ]] && [[ "$DB_HOST" =~ ^[A-Za-z0-9.-]+$ ]] && [[ "$DB_ADMIN_USER" =~ ^[A-Za-z][A-Za-z0-9_]{0,62}$ ]] || die "prepare db: DB_HOST, DB_PORT, DB_NAME or DB_ADMIN_USER has a character that does not belong in one"
  [ -n "$POSTGRES_IMAGE" ] || die "postgres:18 is not pinned in deploy/images.lock"
  make_passwords
  # The roles (NOLOGIN, idempotent), then the passwords of the ones that log in. A password that is already set is set again to the same value: nothing changes.
  sql="$(cat "$HERE/../db/roles.sql")"$'\n'
  for r in "${SERVICE_ROLES[@]}"; do
    f="$(secret_file "$r")"
    sql="$sql"$'\n'"ALTER ROLE rusty_$r LOGIN PASSWORD '$(cat "$f")';"
  done
  printf '%s\n' "$sql" | psql_as "$DB_ADMIN_USER" "$DB_ADMIN_PASSWORD_FILE" >/dev/null || die "prepare db: the roles could not be created (see the database message above: the login's rights, the TLS setting DB_TLS, DB_CA, or pg_hba for the nodes' addresses)"
  echo "prepare db: the roles of the services exist in $DB_NAME on $DB_HOST"
  # Each service role must be able to log in the way the services will (verified TLS, or plain with DB_TLS=0).
  for r in "${SERVICE_ROLES[@]}"; do
    f="$(secret_file "$r")"
    if [ "$(echo "select current_user" | psql_as "rusty_$r" "$f" 2>/dev/null)" = "rusty_$r" ]; then echo "  ok    rusty_$r logs in"; else die "prepare db: rusty_$r cannot log in (does pg_hba allow the nodes' addresses with TLS and scram-sha-256?)"; fi
  done
  echo "prepare db: done; the passwords are in $STATE_DIR/secrets (mode 0600)"
}


# shellcheck source=stack.sh
. "$HERE/stack.sh"

# ---- install docker --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Only where Docker is missing (owner's choice: automatic): get.docker.com is a script of the internet that runs as root. A node reached as a
# container (the local test cluster) already has Docker and is skipped. The user of an ssh node must be root or be allowed `sudo` without a password.
cmd_install_docker() {
  local n t
  for n in $(node_names); do
    t="$(node_field "$n" 2)"
    case "$t" in docker:*) echo "install docker: $n is a container, Docker is there"; continue ;; esac
    if dk "$n" version >/dev/null 2>&1; then echo "install docker: $n already has Docker ($(dk "$n" version --format '{{.Server.Version}}' 2>/dev/null))"; continue; fi
    on "$n" sh -c 'id -u | grep -qx 0 || sudo -n true' >/dev/null 2>&1 || die "install docker: on $n the user is not root and cannot sudo without a password"
    echo "install docker: $n: running get.docker.com (as root) ..."
    on "$n" sh -c 'S=""; [ "$(id -u)" = 0 ] || S="sudo -n"; command -v curl >/dev/null || { echo "curl is missing" >&2; exit 1; }; curl -fsSL https://get.docker.com -o /tmp/get-docker.sh && $S sh /tmp/get-docker.sh >/dev/null && rm -f /tmp/get-docker.sh' || die "install docker: it failed on $n"
    # The user of the transport must be able to use docker in the next ssh session.
    on "$n" sh -c 'id -u | grep -qx 0 || sudo -n usermod -aG docker "$(id -un)"' >/dev/null 2>&1 || true
    echo "install docker: $n done"
  done
}

# ---- init: the whole flow ---------------------------------------------------------------------------------------------------------------------------------------------------------------------
# One command, nothing to switch on: Docker is installed where it is missing (and left alone where it is there), a swarm that is already there is offered for removal (answer y to remove it and start
# clean, n to keep and use it), then the check, the swarm, its proof and the database; the steps that follow (secrets, configs, migration, the stack) are added to this chain as they are built.
# `--yes` answers the question with y (there is no terminal to ask on: a script, CI); without a terminal and without --yes the swarm is kept.
swarm_nodes_in_swarm() { local n; for n in $(node_names); do [ "$(node_state "$n")" = active ] && printf '%s\n' "$n"; done; return 0; }

offer_swarm_removal() {
  local yes="$1" found answer="n" n m
  found="$(swarm_nodes_in_swarm | tr '\n' ' ')"
  [ -n "$found" ] || return 0
  echo "A swarm already exists on: $found"
  if [ "$yes" = 1 ]; then
    answer=y
  elif [ -t 0 ]; then
    read -r -p "Remove it (every node leaves the swarm; its stacks, secrets and configs are lost) and start clean? [y/N] " answer || answer=n
  else
    echo "(no terminal to ask on and no --yes: the swarm is kept)"
  fi
  case "$answer" in
    y|Y|yes|YES)
      m="$(manager_name)"
      for n in $(node_names); do [ "$n" = "$m" ] || { [ "$(node_state "$n")" = active ] && dk "$n" swarm leave --force >/dev/null 2>&1 && echo "removed: $n left the swarm"; }; done
      if [ "$(node_state "$m")" = active ]; then dk "$m" swarm leave --force >/dev/null && echo "removed: the swarm of $m"; fi
      ;;
    *) echo "keeping the existing swarm" ;;
  esac
}

cmd_all() {
  local yes=0
  while [ $# -gt 0 ]; do case "$1" in --yes) yes=1; shift ;; *) die "init: unknown argument $1 (only --yes)" ;; esac; done
  cmd_install_docker
  offer_swarm_removal "$yes"
  cmd_check
  cmd_init
  cmd_verify
  cmd_prepare_db
  cmd_prepare_secrets
  cmd_prepare_configs
  cmd_migrate
  cmd_deploy
  echo "init: done: the stack is deployed (the first start: the admin web prints the setup token in its log: ./rusty-swarm logs admin)"
}

# ---- main ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
validate_inventory
case "${1:-}:${2:-}" in
  init:*) shift; cmd_all "$@" ;;
  inventory:*) cmd_inventory ;;
  cluster:check) cmd_check ;;
  cluster:install-docker) cmd_install_docker ;;
  cluster:init) cmd_init ;;
  cluster:verify) cmd_verify ;;
  prepare:db) cmd_prepare_db ;;
  prepare:secrets) cmd_prepare_secrets ;;
  prepare:configs) cmd_prepare_configs ;;
  migrate:*) cmd_migrate ;;
  deploy:*) cmd_deploy ;;
  stack:*) gen_stack ;;
  logs:*) shift; cmd_logs "$@" ;;
  verify:*) cmd_verify_stack ;;
  *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print } /^set / { exit }' "$0"; [ -z "${1:-}" ] || exit 2 ;;
esac
