blob_dir = "/var/lib/rusty/blobs"
hostname = "mail.example.org"

[tls]
cert_file = "/etc/rusty/tls/cert.pem"
key_file = "/etc/rusty/tls/key.pem"

[store]
url = "postgres://rusty_app@db.internal:5432/rusty"
password_file = "/run/secrets/rusty_pg_password"
migrator_user = "rusty_migrator"
migrator_password_file = "/run/secrets/rusty_pg_migrator_password"
pool_size = 16
lock_timeout_ms = 10000
statement_timeout_ms = 30000
sslmode = "verify-full"
ca_bundle = "/etc/rusty/db-ca.pem"
