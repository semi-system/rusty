# Copy to .rusty-remote.env (untracked) and fill in. KEY=VALUE lines only; never executed.
# See docs/buildserver.md.
BUILD_HOST=10.77.0.20
BUILD_USER=rustybuild
# Private key (ed25519) whose public half is in the VM's ~rustybuild/.ssh/authorized_keys.
BUILD_KEY=C:/Users/YOUR_NAME/.ssh/rusty_build_ed25519
#BUILD_PORT=22
# Pinned host key (create with: bash scripts/remote-sync.sh --pin-host). Default: next to this file.
#BUILD_KNOWN_HOSTS=
# Seconds to wait for a busy lock instead of failing at once (default 0).
#BUILD_LOCK_WAIT=0
# auto (rsync if present, else tar over ssh) | rsync | tar
#BUILD_SYNC=auto
