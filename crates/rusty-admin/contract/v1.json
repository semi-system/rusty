{
  "version": 1,
  "about": "The contract between rusty-admin and the web front end (design sections 4 and 8). The front end types are generated from this file; a test runs every endpoint and checks the real responses against these shapes, and that the routes of the service are exactly the ones listed.",
  "conventions": {
    "base": "/api/v1",
    "errors": "{\"error\": <code>} with a fixed code: invalid 400, unauthorized 401, forbidden 403, not_found 404, exists 409, unsupported 415, throttled 429 (Retry-After), busy 503",
    "mutations": "need Origin = the public origin, Content-Type: application/json and X-CSRF-Token (from GET /session)",
    "scope": "a domain outside the administrator's scope is 404 not_found, the same answer as a domain that does not exist",
    "pagination": "lists return {items, next, total}; pass ?after=<next> for the following page; next is null at the end; total is how many rows match the filter in all; the page size is ?limit= (1 to 100, default 100); ?q= narrows a list to the names that contain the text (letters, digits and ._@+-, at most 64) and ?status= to one status (domains: active, disabled; accounts: active, locked, disabled); each at most once, anything else is 400 invalid"
  },
  "types": {
    "integer": "JSON number without fraction",
    "string": "JSON string",
    "boolean": "true or false",
    "T[]": "array of T",
    "T|null": "T or null"
  },
  "shapes": {
    "Empty": {},
    "Error": { "error": "string" },
    "Me": { "address": "string", "scope": "string", "domain": "integer|null", "csrf": "string" },
    "SetupState": { "required": "boolean" },
    "Domain": { "id": "integer", "name": "string", "status": "string" },
    "Account": { "id": "integer", "address": "string", "status": "string", "has_password": "boolean", "last_login_at": "integer|null", "plan": "string|null", "used_bytes": "integer", "quota_bytes": "integer|null", "last_delivery_at": "integer|null", "must_change_password": "boolean" },
    "AccountCreated": { "id": "integer", "address": "string", "status": "string", "has_password": "boolean", "last_login_at": "integer|null", "plan": "string|null", "used_bytes": "integer", "quota_bytes": "integer|null", "last_delivery_at": "integer|null", "must_change_password": "boolean", "aliases_created": "string[]" },
    "Alias": { "id": "integer", "alias": "string", "target": "string" },
    "AliasCreated": { "alias": "string", "target": "string" },
    "DomainList": { "items": "Domain[]", "next": "integer|null", "total": "integer" },
    "AccountList": { "items": "Account[]", "next": "integer|null", "total": "integer" },
    "AliasList": { "items": "Alias[]", "next": "integer|null", "total": "integer" },
    "Hint": { "topics": "string[]" },
    "AdminEntry": { "id": "integer", "address": "string", "scope": "string", "role": "string", "domain": "string|null", "created_at": "integer" },
    "AdminList": { "items": "AdminEntry[]", "next": "integer|null", "total": "integer" },
    "Dkim": { "selector": "string", "algorithm": "string", "record_name": "string", "record_value": "string", "sealed": "boolean", "created_at": "integer" },
    "DkimList": { "items": "Dkim[]" },
    "Relay": { "host": "string", "port": "integer", "tls": "string", "username": "string|null", "spf_include": "string|null", "password_set": "boolean", "check_status": "string|null", "checked_at": "integer|null" },
    "RelayState": { "relay": "Relay|null" },
    "StorageSettings": { "endpoint": "string", "region": "string", "bucket": "string", "prefix": "string", "path_style": "boolean" },
    "StoragePolicy": { "copies": "integer", "sync_copies": "integer", "placement": "string", "read": "string" },
    "StorageBackend": { "name": "string", "state": "string", "weight": "integer", "check_status": "string", "checked_at": "integer|null", "settings": "StorageSettings|null", "access_key_set": "boolean|null", "secret_key_set": "boolean|null", "objects": "integer|null" },
    "StorageCapacity": { "declared_bytes": "integer|null", "used_bytes": "integer|null", "promised_bytes": "integer|null", "unlimited_accounts": "integer|null", "status": "string" },
    "Storage": { "capacity": "StorageCapacity|null", "kind": "string", "ready": "boolean", "check_status": "string", "checked_at": "integer|null", "settings": "StorageSettings|null", "access_key_set": "boolean|null", "secret_key_set": "boolean|null", "policy": "StoragePolicy|null", "backends": "StorageBackend[]|null" },
    "StorageState": { "storage": "Storage|null" },
    "Queued": { "queued": "boolean" },
    "DnsRecord": { "name": "string", "type": "string", "value": "string", "ttl": "integer", "purpose": "string", "required": "string", "status": "string", "seen": "string|null", "last_checked_at": "integer|null" },
    "DnsRecords": { "records": "DnsRecord[]", "warnings": "string[]" },
    "Queue": { "queued": "integer", "running": "integer", "failed": "integer", "dead": "integer" },
    "MonitorInstance": { "instance": "string", "version": "string", "uptime_secs": "integer", "age_secs": "integer", "stale": "boolean", "replaced": "boolean", "status": "string", "listeners": "integer|null" },
    "MonitorService": { "service": "string", "status": "string", "instances": "MonitorInstance[]" },
    "MonitorQueue": { "queued": "integer", "running": "integer", "failed": "integer", "dead": "integer", "oldest_due_secs": "integer" },
    "MonitorCount": { "status": "string", "count": "integer" },
    "Monitor": { "services": "MonitorService[]", "queue": "MonitorQueue", "storage": "MonitorCount[]", "dns_problem_domains": "integer" },
    "Protocol": { "name": "string", "enabled": "boolean" },
    "Protocols": { "protocols": "Protocol[]" },
    "Plan": { "name": "string", "quota_bytes": "integer|null", "max_message_bytes": "integer|null", "messages_per_hour": "integer|null", "protocols": "string[]|null", "spam_junk_score": "number|null", "spam_reject_score": "number|null" },
    "PlanList": { "items": "Plan[]" },
    "AccountPlan": { "plan": "string|null" },
    "Deletion": { "deletion": "string" },
    "MailList": { "local": "string", "address": "string", "members": "integer" },
    "Routing": { "lists": "MailList[]", "catch_all": "string|null", "domain_aliases": "string[]" },
    "Member": { "seq": "integer", "address": "string", "external": "boolean" },
    "Members": { "items": "Member[]" },
    "CatchAll": { "catch_all": "string|null" },
    "DomainAliasName": { "name": "string" },
    "SearchFound": { "account": "string", "folder": "string", "at": "integer", "from": "string", "subject": "string", "size": "integer" },
    "Search": { "id": "integer", "state": "string", "found": "integer", "truncated": "boolean", "results": "SearchFound[]", "error": "string|null", "created_at": "integer", "finished_at": "integer|null" },
    "SearchQueued": { "id": "integer", "state": "string" },
    "PlatformSettings": { "quota_bytes": "integer|null", "max_message_bytes": "integer|null", "messages_per_hour": "integer|null", "virus_action": "string|null", "blocked_extensions": "string[]", "admin_search": "boolean" },
    "DomainSettings": { "blocked_extensions": "string[]", "footer_text": "string|null", "sender_allow": "string[]", "sender_block": "string[]", "default_plan": "string|null", "max_accounts": "integer|null", "quota_bytes": "integer|null", "max_message_bytes": "integer|null", "password_min_length": "integer|null", "password_classes": "integer|null" },
    "ImportRow": { "line": "integer", "address": "string", "result": "string", "reason": "string|null" },
    "ImportResult": { "dry_run": "boolean", "created": "integer", "exists": "integer", "invalid": "integer", "rows": "ImportRow[]" },
    "QueueJob": { "id": "integer", "state": "string", "sender": "string", "recipients": "string[]", "destination": "string", "attempts": "integer", "created_at": "integer", "next_attempt_at": "integer|null", "last_error": "string|null" },
    "QueueList": { "items": "QueueJob[]", "next": "integer|null" },
    "LogLine": { "id": "integer", "direction": "string", "at": "integer", "sender": "string", "recipient": "string", "event": "string", "remote": "string|null", "status": "string|null", "detail": "string|null" },
    "Trace": { "items": "LogLine[]", "next": "integer|null" },
    "Transfer": { "id": "integer", "kind": "string", "requested_by": "string", "state": "string", "folder": "string|null", "size": "integer", "messages": "integer", "skipped": "integer", "error": "string|null", "created_at": "integer", "finished_at": "integer|null", "expires_at": "integer" },
    "TransferList": { "items": "Transfer[]" },
    "MailForward": { "to": "string[]", "keep": "boolean" },
    "MailVacation": { "enabled": "boolean", "subject": "string", "body": "string", "from": "integer|null", "until": "integer|null" },
    "MailRules": { "forward": "MailForward|null", "vacation": "MailVacation|null" },
    "Certificate": { "host": "string", "port": "integer", "purpose": "string", "subject": "string|null", "issuer": "string|null", "not_before": "integer|null", "not_after": "integer|null", "days_left": "integer|null", "error": "string|null" },
    "CertificateList": { "items": "Certificate[]" },
    "DayStats": { "day": "integer", "received": "integer", "rejected": "integer", "sent": "integer", "deferred": "integer", "failed": "integer" },
    "Stats": { "days": "DayStats[]" },
    "AuditEntry": { "id": "integer", "at": "integer", "actor": "string", "domain_id": "integer|null", "ip": "string", "method": "string", "route": "string", "path": "string", "status": "integer", "detail": "string|null" },
    "Audit": { "items": "AuditEntry[]", "next": "integer|null" }
  },
  "endpoints": [
    { "method": "GET", "path": "/mail/config-v1.1.xml", "auth": "none", "request": { "emailaddress": "string (query, optional)" }, "response": null, "status": 200, "note": "Mozilla autoconfig XML for mail clients (the platform's IMAP and submission servers), whatever the domain; served on port 80 for hosts autoconfig.*; 404 when no mail host is configured" },
    { "method": "POST", "path": "/api/v1/session", "auth": "none", "request": { "address": "string", "password": "string" }, "response": "Me", "status": 200 },
    { "method": "GET", "path": "/api/v1/session", "auth": "admin", "request": null, "response": "Me", "status": 200 },
    { "method": "DELETE", "path": "/api/v1/session", "auth": "admin", "request": null, "response": "Empty", "status": 200 },
    { "method": "GET", "path": "/api/v1/setup", "auth": "none", "request": null, "response": "SetupState", "status": 200, "note": "404 once a platform administrator exists" },
    { "method": "POST", "path": "/api/v1/setup", "auth": "none", "request": { "token": "string", "address": "string", "password": "string" }, "response": "Me", "status": 201, "note": "404 once a platform administrator exists" },
    { "method": "GET", "path": "/api/v1/domains", "auth": "admin", "request": null, "response": "DomainList", "status": 200, "note": "a domain administrator sees its own domain only" },
    { "method": "POST", "path": "/api/v1/domains", "auth": "platform", "request": { "name": "string" }, "response": "Domain", "status": 201 },
    { "method": "POST", "path": "/api/v1/domains/{d}/disable", "auth": "platform", "request": null, "response": "Domain", "status": 200 },
    { "method": "POST", "path": "/api/v1/domains/{d}/enable", "auth": "platform", "request": null, "response": "Domain", "status": 200 },
    { "method": "GET", "path": "/api/v1/domains/{d}/accounts", "auth": "admin", "request": null, "response": "AccountList", "status": 200 },
    { "method": "POST", "path": "/api/v1/domains/{d}/accounts", "auth": "admin", "request": { "local": "string", "password": "string|null (optional)" }, "response": "AccountCreated", "status": 201 },
    { "method": "POST", "path": "/api/v1/accounts/{a}/password", "auth": "admin", "request": { "password": "string", "must_change": "boolean (optional)" }, "response": "Empty", "status": 200 },
    { "method": "POST", "path": "/api/v1/accounts/{a}/disable", "auth": "admin", "request": null, "response": "Account", "status": 200 },
    { "method": "POST", "path": "/api/v1/accounts/{a}/lock", "auth": "admin", "request": null, "response": "Account", "status": 200, "note": "locked: cannot sign in, mail still arrives; disable (closed): neither" },
    { "method": "POST", "path": "/api/v1/accounts/{a}/enable", "auth": "admin", "request": null, "response": "Account", "status": 200 },
    { "method": "GET", "path": "/api/v1/domains/{d}/aliases", "auth": "admin", "request": null, "response": "AliasList", "status": 200 },
    { "method": "POST", "path": "/api/v1/domains/{d}/aliases", "auth": "admin", "request": { "local": "string", "target": "string" }, "response": "AliasCreated", "status": 201 },
    { "method": "DELETE", "path": "/api/v1/aliases/{a}", "auth": "admin", "request": null, "response": "Empty", "status": 200 },
    { "method": "GET", "path": "/api/v1/events", "auth": "admin", "request": null, "response": "Hint", "status": 200, "note": "text/event-stream: the data of each `changed` event is a Hint (topics that changed, never data); `resync` has no topics: refresh everything. docs/design-live-updates.md" },
    { "method": "GET", "path": "/api/v1/admins", "auth": "admin", "request": null, "response": "AdminList", "status": 200, "note": "a platform administrator sees all, a domain administrator its own domain" },
    { "method": "POST", "path": "/api/v1/admins", "auth": "platform", "request": { "address": "string", "domain": "string|null", "role": "string (optional: admin, or helpdesk, which needs a domain)" }, "response": "AdminEntry", "status": 201, "note": "domain null: a platform administrator; helpdesk: may only list accounts, set passwords, lock and unlock" },
    { "method": "DELETE", "path": "/api/v1/admins/{a}", "auth": "platform", "request": null, "response": "Empty", "status": 200, "note": "never yourself, never the last platform administrator" },
    { "method": "GET", "path": "/api/v1/domains/{d}/dkim", "auth": "admin", "request": null, "response": "DkimList", "status": 200, "note": "public records only" },
    { "method": "DELETE", "path": "/api/v1/domains/{d}/dkim/{k}", "auth": "admin", "request": null, "response": "Empty", "status": 200, "note": "retire a key after a rotation; the last key cannot be retired (409 wrong_state)" },
    { "method": "POST", "path": "/api/v1/domains/{d}/dkim", "auth": "admin", "request": { "selector": "string|null (optional, default rusty)" }, "response": "Dkim", "status": 201, "note": "the private key is sealed to the outbound service and never returned; 409 exists for a selector already published; 503 unavailable without [sealing]" },
    { "method": "GET", "path": "/api/v1/domains/{d}/relay", "auth": "admin", "request": null, "response": "RelayState", "status": 200, "note": "never the password" },
    { "method": "PUT", "path": "/api/v1/domains/{d}/relay", "auth": "admin", "request": { "host": "string", "port": "integer", "tls": "string (starttls|implicit|none)", "username": "string|null (optional)", "spf_include": "string|null (optional)", "password": "string|null (required with username, refused without)" }, "response": "RelayState", "status": 200, "note": "ports 25, 465, 587, 2525; a public host; a login only over TLS; the password is sealed" },
    { "method": "DELETE", "path": "/api/v1/domains/{d}/relay", "auth": "admin", "request": null, "response": "Empty", "status": 200 },
    { "method": "POST", "path": "/api/v1/domains/{d}/relay/check", "auth": "admin", "request": null, "response": "Queued", "status": 200, "note": "the outbound service runs it; the result shows in GET relay" },
    { "method": "GET", "path": "/api/v1/domains/{d}/storage", "auth": "admin", "request": null, "response": "StorageState", "status": 200, "note": "null: the domain uses the platform store; never the keys; settings and key flags are null for a domain administrator" },
    { "method": "PUT", "path": "/api/v1/domains/{d}/storage", "auth": "platform", "request": { "endpoint": "string", "region": "string", "bucket": "string", "prefix": "string (optional)", "path_style": "boolean (optional)", "access_key": "string", "secret_key": "string" }, "response": "StorageState", "status": 200, "note": "an S3 store of the domain's own: https, a public host, port 443/8443/9000/9443; the keys are sealed; the settings change only while the store is empty; the store is used only after a check passed" },
    { "method": "PUT", "path": "/api/v1/domains/{d}/storage/capacity", "auth": "platform", "request": { "capacity_bytes": "integer|null" }, "response": "Queued", "status": 200, "note": "declare the room of the tenant's store (S3 cannot say); a check is queued and judges it against what the tenant holds and has been promised" },
    { "method": "POST", "path": "/api/v1/domains/{d}/storage/check", "auth": "platform", "request": null, "response": "Queued", "status": 200, "note": "the mail service runs it (an S3 store, or every backend of a pool); the result shows in GET storage" },
    { "method": "PUT", "path": "/api/v1/domains/{d}/storage/pool", "auth": "platform", "request": { "copies": "integer (optional, default 1)", "sync_copies": "integer (optional, default copies when copies is given, else 1)", "placement": "string (ordered|weighted, optional)", "read": "string (located|ordered|round_robin|fastest, optional)" }, "response": "StorageState", "status": 200, "note": "the domain's store becomes a pool of backends (JBOD: copies 1; mirror: copies N; failover: copies 2, sync_copies 1, ordered); the policy changes only while the pool holds no body; 409 for a domain with another kind of store" },
    { "method": "POST", "path": "/api/v1/domains/{d}/storage/backends", "auth": "platform", "request": { "name": "string (a-z, 0-9, - and _, 1 to 32)", "endpoint": "string", "region": "string", "bucket": "string", "prefix": "string (optional)", "path_style": "boolean (optional)", "weight": "integer (optional, 1 to 1000, default 100)", "access_key": "string", "secret_key": "string" }, "response": "StorageState", "status": 200, "note": "an S3 backend of the domain's pool, at most 8; the rules of PUT storage apply; 404 when the domain has no pool; 409 for a name in use; the pool is used only after every backend passed a check" },
    { "method": "PUT", "path": "/api/v1/domains/{d}/storage/backends/{b}", "auth": "platform", "request": { "state": "string (active|readonly|draining|disabled, optional)", "weight": "integer (optional)" }, "response": "StorageState", "status": 200, "note": "a draining backend is emptied by the repair job" },
    { "method": "POST", "path": "/api/v1/domains/{d}/storage/backends/{b}/keys", "auth": "platform", "request": { "access_key": "string", "secret_key": "string" }, "response": "StorageState", "status": 200, "note": "replaces the keys; the backend is unchecked until the next check" },
    { "method": "DELETE", "path": "/api/v1/domains/{d}/storage/backends/{b}", "auth": "platform", "request": null, "response": "Empty", "status": 200, "note": "409 while the backend holds an object: drain it first" },
    { "method": "GET", "path": "/api/v1/domains/{d}/outbound", "auth": "admin", "request": null, "response": "Queue", "status": 200, "note": "outgoing messages of this domain by state; mail waiting for a failing relay shows as queued" },
    { "method": "GET", "path": "/api/v1/domains/{d}/dns", "auth": "admin", "request": null, "response": "DnsRecords", "status": 200, "note": "status is the last check of the record as it is now, or unchecked; 503 unavailable when no host name is configured" },
    { "method": "POST", "path": "/api/v1/domains/{d}/dns/check", "auth": "admin", "request": null, "response": "Queued", "status": 200, "note": "the service that can query DNS runs it; the result shows in GET dns" },
    { "method": "GET", "path": "/api/v1/monitor", "auth": "platform", "request": null, "response": "Monitor", "status": 200, "note": "the services (ok, degraded or down by their heartbeats, per instance), the outbound queue of every domain, the storage check states and the domains with DNS problems; computed on the server" },
    { "method": "GET", "path": "/api/v1/protocols", "auth": "platform", "request": null, "response": "Protocols", "status": 200, "note": "the optional protocols (pop3) and whether each is on; one never set is on" },
    { "method": "PUT", "path": "/api/v1/protocols", "auth": "platform", "request": { "protocol": "string", "enabled": "boolean" }, "response": "Protocols", "status": 200, "note": "switch a protocol on or off for every replica of the mail services (they read the setting within a few seconds); 400 invalid for an unknown protocol" },
    { "method": "DELETE", "path": "/api/v1/accounts/{a}", "auth": "admin", "request": null, "response": "Deletion", "status": 200, "note": "a closed (disabled) account is removed with its mailbox by the garbage collector at its next pass; 409 not_closed for an account that is not closed; 400 for the account you are signed in with" },
    { "method": "DELETE", "path": "/api/v1/domains/{d}", "auth": "platform", "request": null, "response": "Empty", "status": 200, "note": "409 not_empty while the domain has accounts, aliases, lists, pending jobs or storage of its own" },
    { "method": "GET", "path": "/api/v1/domains/{d}/routing", "auth": "admin", "request": null, "response": "Routing", "status": 200, "note": "the distribution lists, the catch-all local part and the alias domains of a domain" },
    { "method": "POST", "path": "/api/v1/domains/{d}/lists", "auth": "admin", "request": { "local": "string" }, "response": "MailList", "status": 201 },
    { "method": "DELETE", "path": "/api/v1/domains/{d}/lists/{l}", "auth": "admin", "request": null, "response": "Empty", "status": 200 },
    { "method": "GET", "path": "/api/v1/domains/{d}/lists/{l}/members", "auth": "admin", "request": null, "response": "Members", "status": 200 },
    { "method": "POST", "path": "/api/v1/domains/{d}/lists/{l}/members", "auth": "admin", "request": { "address": "string" }, "response": "Members", "status": 201, "note": "an account of any hosted domain, or an address outside this server (the list forwards to it); 400 invalid for an address of a hosted domain that has no such account; 409 exists when already a member" },
    { "method": "DELETE", "path": "/api/v1/domains/{d}/lists/{l}/members/{n}", "auth": "admin", "request": null, "response": "Empty", "status": 200 },
    { "method": "PUT", "path": "/api/v1/domains/{d}/catch-all", "auth": "admin", "request": { "local": "string|null" }, "response": "CatchAll", "status": 200, "note": "the account, alias or list of this domain that takes mail for addresses that do not exist; null clears it; 400 invalid when it names nothing" },
    { "method": "POST", "path": "/api/v1/domains/{d}/domain-aliases", "auth": "platform", "request": { "name": "string" }, "response": "DomainAliasName", "status": 201, "note": "409 exists when the name is a hosted domain or an alias already" },
    { "method": "DELETE", "path": "/api/v1/domains/{d}/domain-aliases/{n}", "auth": "platform", "request": null, "response": "Empty", "status": 200 },
    { "method": "POST", "path": "/api/v1/domains/{d}/accounts/import", "auth": "admin", "request": { "csv": "string", "dry_run": "boolean (optional)" }, "response": "ImportResult", "status": 200, "note": "one line per account: address or name, password (optional), plan (optional); at most 500 lines; dry_run changes nothing; a line that is not valid or already exists is reported and skipped, the others are made" },
    { "method": "POST", "path": "/api/v1/search", "auth": "platform", "request": { "domain": "string (optional)", "account": "string (optional, an address)", "from": "string (optional)", "to": "string (optional)", "subject": "string (optional)", "since": "integer (optional, unix seconds)", "until": "integer (optional, unix seconds)" }, "response": "SearchQueued", "status": 201, "note": "asks the IMAP service to look in the mail of every mailbox (or of one domain or account) for messages whose sender, a recipient or subject contains the text, or that are dated in the range; at least one of from, to, subject, since or until; 409 wrong_state while the platform setting admin_search is off; the audit log keeps who asked and what for" },
    { "method": "GET", "path": "/api/v1/search/{s}", "auth": "platform", "request": null, "response": "Search", "status": 200, "note": "what the search found so far: queued, running, done or failed, and at most 100 results (account, folder, date, sender, subject, size; never a body); kept a day" },
    { "method": "GET", "path": "/api/v1/settings", "auth": "admin", "request": null, "response": "PlatformSettings", "status": 200, "note": "platform administrators only: the platform-wide limits, the last layer under plan, domain and account; a missing one is null" },
    { "method": "PUT", "path": "/api/v1/settings", "auth": "admin", "request": { "quota_bytes": "integer|null", "max_message_bytes": "integer|null", "messages_per_hour": "integer|null", "virus_action": "string|null (reject or quarantine)", "blocked_extensions": "string[] (optional)", "admin_search": "boolean (optional, default false)" }, "response": "PlatformSettings", "status": 200, "note": "takes effect on the next delivery or sign-in, without a restart" },
    { "method": "GET", "path": "/api/v1/domains/{d}/settings", "auth": "admin", "request": null, "response": "DomainSettings", "status": 200, "note": "the defaults and limits of the domain; a missing one is null" },
    { "method": "PUT", "path": "/api/v1/domains/{d}/settings", "auth": "admin", "request": { "blocked_extensions": "string[] (optional: extensions without a dot)", "footer_text": "string|null (optional, up to 2000 characters)", "sender_allow": "string[] (optional)", "sender_block": "string[] (optional)", "default_plan": "string|null", "max_accounts": "integer|null", "quota_bytes": "integer|null", "max_message_bytes": "integer|null", "password_min_length": "integer|null (8 to 128)", "password_classes": "integer|null (0 to 4)" }, "response": "DomainSettings", "status": 200, "note": "sets every value (null removes it); a domain administrator may change only the two password rules (403 otherwise); 400 invalid for an unknown plan or an out-of-range value" },
    { "method": "GET", "path": "/api/v1/domains/{d}/queue", "auth": "admin", "request": null, "response": "QueueList", "status": 200, "note": "the outbound queue of the domain, newest first, 50 a page; query: state (waiting, held, running, failed, dead, done), q (a recipient, the sender or the destination), before (a job id)" },
    { "method": "POST", "path": "/api/v1/domains/{d}/queue/{n}/hold", "auth": "admin", "request": null, "response": "Empty", "status": 200, "note": "no worker takes a held job until it is released; 409 wrong_state when the job is not queued" },
    { "method": "POST", "path": "/api/v1/domains/{d}/queue/{n}/release", "auth": "admin", "request": null, "response": "Empty", "status": 200, "note": "make a queued job due now (releases a held one); 409 wrong_state when the job is not queued" },
    { "method": "POST", "path": "/api/v1/domains/{d}/queue/{n}/retry", "auth": "admin", "request": null, "response": "Empty", "status": 200, "note": "put a given-up (dead or failed) job back in the queue; 409 wrong_state otherwise" },
    { "method": "DELETE", "path": "/api/v1/domains/{d}/queue/{n}", "auth": "admin", "request": null, "response": "Empty", "status": 200, "note": "delete a job no worker holds; 409 wrong_state while one does" },
    { "method": "GET", "path": "/api/v1/domains/{d}/stats", "auth": "admin", "request": null, "response": "Stats", "status": 200, "note": "mail counted per UTC day, newest day first: received, rejected, sent, deferred, failed; query: days (1 to 365, default 30); the last 28 days come from the delivery log, older ones from a daily roll-up kept 400 days" },
    { "method": "GET", "path": "/api/v1/domains/{d}/trace", "auth": "admin", "request": null, "response": "Trace", "status": 200, "note": "the delivery log of the domain's outgoing mail (kept 30 days), newest first; query: held=1 for only the mail that went to the Spam folder, q (a recipient or the sender), before (a log id)" },
    { "method": "POST", "path": "/api/v1/accounts/{a}/exports", "auth": "platform", "request": null, "response": "Transfer", "status": 201, "note": "ask for the export of the whole mailbox as one mbox file (every message marked with its folder); the IMAP service writes it and it is kept a day" },
    { "method": "POST", "path": "/api/v1/accounts/{a}/imports", "auth": "platform", "request": { "folder": "string|null (optional)" }, "response": "Transfer", "status": 201, "note": "begin an import: upload the file in pieces (PUT .../chunks/{n}, at most 48 KiB each, 64 MiB in all), then POST .../start" },
    { "method": "PUT", "path": "/api/v1/transfers/{t}/chunks/{n}", "auth": "platform", "request": "bytes", "response": "Empty", "status": 200, "note": "piece n of an import's file; the body is the raw bytes; not in the audit log (the import is, when it starts)" },
    { "method": "POST", "path": "/api/v1/transfers/{t}/start", "auth": "platform", "request": { "pieces": "integer" }, "response": "Transfer", "status": 200, "note": "the file has arrived (pieces 0 to pieces-1): queue the import" },
    { "method": "GET", "path": "/api/v1/accounts/{a}/transfers", "auth": "platform", "request": null, "response": "TransferList", "status": 200, "note": "the newest exports and imports of the account" },
    { "method": "GET", "path": "/api/v1/transfers/{t}", "auth": "platform", "request": null, "response": "Transfer", "status": 200, "note": "one transfer, for the page that waits for it" },
    { "method": "GET", "path": "/api/v1/transfers/{t}/download", "auth": "platform", "request": null, "response": "bytes", "status": 200, "note": "the mbox file of a finished export; the download is written to the audit log" },
    { "method": "GET", "path": "/api/v1/accounts/{a}/mail-rules", "auth": "admin", "request": null, "response": "MailRules", "status": 200, "note": "forwarding and the automatic reply of the account" },
    { "method": "PUT", "path": "/api/v1/accounts/{a}/mail-rules", "auth": "admin", "request": { "forward": "MailForward|null (optional: one to ten addresses)", "vacation": "MailVacation|null (optional; an enabled reply needs a text)" }, "response": "MailRules", "status": 200, "note": "replaces the rules; an empty object removes them" },
    { "method": "GET", "path": "/api/v1/certificates", "auth": "platform", "request": null, "response": "CertificateList", "status": 200, "note": "what a client is handed at the public names of this server (the admin web's host and the mail host's 993, 995 and 465), read by connecting; a probe that failed carries an error text" },
    { "method": "GET", "path": "/api/v1/audit", "auth": "admin", "request": null, "response": "Audit", "status": 200, "note": "the changes administrators made, newest first (kept 365 days); a domain administrator gets its own domain; query: domain, before" },
    { "method": "GET", "path": "/api/v1/plans", "auth": "admin", "request": null, "response": "PlanList", "status": 200 },
    { "method": "PUT", "path": "/api/v1/plans", "auth": "platform", "request": { "name": "string", "quota_bytes": "integer|null", "max_message_bytes": "integer|null", "messages_per_hour": "integer|null (optional)", "protocols": "string[]|null (optional: imap, pop3, submission)", "spam_junk_score": "number|null (optional, 0 to 100)", "spam_reject_score": "number|null (optional, 0 to 100, above the junk score)" }, "response": "Plan", "status": 200, "note": "creates the plan (201) or changes its limits; a null limit removes it; the services read the limits when they open a mailbox" },
    { "method": "PUT", "path": "/api/v1/accounts/{a}/plan", "auth": "admin", "request": { "plan": "string|null" }, "response": "AccountPlan", "status": 200, "note": "put the account on the plan, or on none with null" }
  ]
}
