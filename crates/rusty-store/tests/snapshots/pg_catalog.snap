INDEX capabilities.capabilities_expires CREATE INDEX capabilities_expires ON public.capabilities USING btree (expires_at)
INDEX capabilities.capabilities_pkey CREATE UNIQUE INDEX capabilities_pkey ON public.capabilities USING btree (token_hash)
INDEX capabilities.capabilities_revoked CREATE INDEX capabilities_revoked ON public.capabilities USING btree (revoked_at) WHERE (revoked_at IS NOT NULL)
