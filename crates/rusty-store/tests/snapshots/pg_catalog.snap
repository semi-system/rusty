CONSTRAINT audit_log.audit_log_route_valid CHECK (length(route) <= 200)
CONSTRAINT audit_log.audit_log_status_not_null NOT NULL status
CONSTRAINT blob_backends.blob_backends_check_status_not_null NOT NULL check_status
CONSTRAINT blob_backends.blob_backends_check_valid CHECK (length(check_status) >= 1 AND length(check_status) <= 64)
