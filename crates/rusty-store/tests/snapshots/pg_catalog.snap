CONSTRAINT aliases.aliases_local_part_not_null NOT NULL local_part
CONSTRAINT aliases.aliases_local_part_valid CHECK (length(local_part) > 0 AND local_part = lower(local_part))
CONSTRAINT aliases.aliases_pkey PRIMARY KEY (id)
CONSTRAINT audit_log.audit_log_actor_not_null NOT NULL actor
CONSTRAINT audit_log.audit_log_actor_valid CHECK (length(actor) <= 320)
CONSTRAINT audit_log.audit_log_at_not_null NOT NULL at
CONSTRAINT audit_log.audit_log_at_valid CHECK (at >= 0)
