INDEX domains.domains_name_key CREATE UNIQUE INDEX domains_name_key ON public.domains USING btree (name)
INDEX domains.domains_pkey CREATE UNIQUE INDEX domains_pkey ON public.domains USING btree (id)
INDEX folders.folders_pkey CREATE UNIQUE INDEX folders_pkey ON public.folders USING btree (mailbox_id, id)
INDEX folders.folders_role CREATE UNIQUE INDEX folders_role ON public.folders USING btree (mailbox_id, role) WHERE (role <> 'custom'::text)
INDEX folders.folders_sibling_name CREATE UNIQUE INDEX folders_sibling_name ON public.folders USING btree (mailbox_id, COALESCE(parent_id, (0)::bigint), name)
INDEX jobs.jobs_domain_state CREATE INDEX jobs_domain_state ON public.jobs USING btree (domain_id, state)
INDEX jobs.jobs_pkey CREATE UNIQUE INDEX jobs_pkey ON public.jobs USING btree (id)
INDEX jobs.jobs_queued_order CREATE INDEX jobs_queued_order ON public.jobs USING btree (run_after, id) WHERE (state = 'queued'::text)
INDEX jobs.jobs_running_lease CREATE INDEX jobs_running_lease ON public.jobs USING btree (lease_expires_at) WHERE (state = 'running'::text)
INDEX keywords.keywords_pkey CREATE UNIQUE INDEX keywords_pkey ON public.keywords USING btree (mailbox_id, message_id, keyword)
INDEX list_members.list_members_list_id_account_id_key CREATE UNIQUE INDEX list_members_list_id_account_id_key ON public.list_members USING btree (list_id, account_id)
INDEX list_members.list_members_list_id_external_key CREATE UNIQUE INDEX list_members_list_id_external_key ON public.list_members USING btree (list_id, external)
INDEX list_members.list_members_seq CREATE UNIQUE INDEX list_members_seq ON public.list_members USING btree (list_id, seq)
INDEX lists.lists_local_part_domain_id_key CREATE UNIQUE INDEX lists_local_part_domain_id_key ON public.lists USING btree (local_part, domain_id)
INDEX lists.lists_pkey CREATE UNIQUE INDEX lists_pkey ON public.lists USING btree (id)
INDEX mailboxes.mailboxes_account_id_key CREATE UNIQUE INDEX mailboxes_account_id_key ON public.mailboxes USING btree (account_id)
INDEX mailboxes.mailboxes_pkey CREATE UNIQUE INDEX mailboxes_pkey ON public.mailboxes USING btree (id)
INDEX messages.messages_blob_hash CREATE INDEX messages_blob_hash ON public.messages USING btree (blob_hash)
INDEX messages.messages_deleted_at CREATE INDEX messages_deleted_at ON public.messages USING btree (deleted_at) WHERE (deleted_at IS NOT NULL)
INDEX messages.messages_mailbox_id_folder_id_uid_key CREATE UNIQUE INDEX messages_mailbox_id_folder_id_uid_key ON public.messages USING btree (mailbox_id, folder_id, uid)
INDEX messages.messages_msgid CREATE INDEX messages_msgid ON public.messages USING btree (mailbox_id, message_id_hdr)
INDEX messages.messages_pkey CREATE UNIQUE INDEX messages_pkey ON public.messages USING btree (mailbox_id, id)
INDEX messages.messages_thread CREATE INDEX messages_thread ON public.messages USING btree (mailbox_id, thread_id)
INDEX plans.plans_name_key CREATE UNIQUE INDEX plans_name_key ON public.plans USING btree (name)
INDEX plans.plans_pkey CREATE UNIQUE INDEX plans_pkey ON public.plans USING btree (id)
TRIGGER accounts.accounts_addr_truncate CREATE TRIGGER accounts_addr_truncate AFTER TRUNCATE ON accounts FOR EACH STATEMENT EXECUTE FUNCTION rs_address_truncate()
TRIGGER accounts.accounts_addr_unique_del CREATE TRIGGER accounts_addr_unique_del BEFORE DELETE ON accounts FOR EACH ROW EXECUTE FUNCTION rs_address_unique()
TRIGGER accounts.accounts_addr_unique_ins CREATE TRIGGER accounts_addr_unique_ins BEFORE INSERT ON accounts FOR EACH ROW EXECUTE FUNCTION rs_address_unique()
TRIGGER accounts.accounts_addr_unique_upd CREATE TRIGGER accounts_addr_unique_upd BEFORE UPDATE OF local_part, domain_id ON accounts FOR EACH ROW EXECUTE FUNCTION rs_address_unique()
TRIGGER address_owners.address_owners_guard CREATE TRIGGER address_owners_guard BEFORE INSERT OR DELETE OR UPDATE ON address_owners FOR EACH ROW EXECUTE FUNCTION rs_address_owners_guard()
TRIGGER address_owners.address_owners_truncate_guard CREATE TRIGGER address_owners_truncate_guard BEFORE TRUNCATE ON address_owners FOR EACH STATEMENT EXECUTE FUNCTION rs_address_owners_truncate_guard()
TRIGGER aliases.aliases_addr_truncate CREATE TRIGGER aliases_addr_truncate AFTER TRUNCATE ON aliases FOR EACH STATEMENT EXECUTE FUNCTION rs_address_truncate()
TRIGGER aliases.aliases_addr_unique_del CREATE TRIGGER aliases_addr_unique_del BEFORE DELETE ON aliases FOR EACH ROW EXECUTE FUNCTION rs_address_unique()
TRIGGER aliases.aliases_addr_unique_ins CREATE TRIGGER aliases_addr_unique_ins BEFORE INSERT ON aliases FOR EACH ROW EXECUTE FUNCTION rs_address_unique()
TRIGGER aliases.aliases_addr_unique_upd CREATE TRIGGER aliases_addr_unique_upd BEFORE UPDATE OF local_part, domain_id ON aliases FOR EACH ROW EXECUTE FUNCTION rs_address_unique()
TRIGGER aliases.aliases_same_domain_ins CREATE TRIGGER aliases_same_domain_ins BEFORE INSERT ON aliases FOR EACH ROW EXECUTE FUNCTION rs_alias_same_domain()
TRIGGER aliases.aliases_same_domain_upd CREATE TRIGGER aliases_same_domain_upd BEFORE UPDATE OF domain_id, account_id ON aliases FOR EACH ROW EXECUTE FUNCTION rs_alias_same_domain()
TRIGGER blobs.blobs_zero_since_ins CREATE TRIGGER blobs_zero_since_ins BEFORE INSERT ON blobs FOR EACH ROW EXECUTE FUNCTION rs_blobs_zero_since()
TRIGGER blobs.blobs_zero_since_refcount CREATE TRIGGER blobs_zero_since_refcount BEFORE UPDATE OF refcount ON blobs FOR EACH ROW EXECUTE FUNCTION rs_blobs_zero_since()
TRIGGER folders.folders_no_cycle CREATE TRIGGER folders_no_cycle BEFORE UPDATE OF parent_id ON folders FOR EACH ROW EXECUTE FUNCTION rs_folders_no_cycle()
TRIGGER list_members.list_members_same_domain_ins CREATE TRIGGER list_members_same_domain_ins BEFORE INSERT ON list_members FOR EACH ROW EXECUTE FUNCTION rs_list_member_same_domain()
TRIGGER list_members.list_members_same_domain_upd CREATE TRIGGER list_members_same_domain_upd BEFORE UPDATE OF account_id, list_id ON list_members FOR EACH ROW EXECUTE FUNCTION rs_list_member_same_domain()
TRIGGER list_members.list_members_seq_ins CREATE TRIGGER list_members_seq_ins BEFORE INSERT ON list_members FOR EACH ROW WHEN (new.seq IS NULL) EXECUTE FUNCTION rs_list_members_seq()
TRIGGER lists.lists_addr_truncate CREATE TRIGGER lists_addr_truncate AFTER TRUNCATE ON lists FOR EACH STATEMENT EXECUTE FUNCTION rs_address_truncate()
TRIGGER lists.lists_addr_unique_del CREATE TRIGGER lists_addr_unique_del BEFORE DELETE ON lists FOR EACH ROW EXECUTE FUNCTION rs_address_unique()
TRIGGER lists.lists_addr_unique_ins CREATE TRIGGER lists_addr_unique_ins BEFORE INSERT ON lists FOR EACH ROW EXECUTE FUNCTION rs_address_unique()
TRIGGER lists.lists_addr_unique_upd CREATE TRIGGER lists_addr_unique_upd BEFORE UPDATE OF local_part, domain_id ON lists FOR EACH ROW EXECUTE FUNCTION rs_address_unique()
TRIGGER messages.messages_refcount_del CREATE TRIGGER messages_refcount_del AFTER DELETE ON messages FOR EACH ROW EXECUTE FUNCTION rs_messages_refcount()
TRIGGER messages.messages_refcount_ins CREATE TRIGGER messages_refcount_ins AFTER INSERT ON messages FOR EACH ROW EXECUTE FUNCTION rs_messages_refcount()
TRIGGER messages.messages_refcount_upd CREATE TRIGGER messages_refcount_upd AFTER UPDATE OF blob_hash ON messages FOR EACH ROW EXECUTE FUNCTION rs_messages_refcount()
FUNCTION rs_address_owners_guard
CREATE OR REPLACE FUNCTION public.rs_address_owners_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  IF pg_trigger_depth() < 2 THEN
    RAISE EXCEPTION 'address_owners is maintained by triggers only' USING ERRCODE = 'RS003';
  END IF;
  IF TG_OP = 'DELETE' THEN
    RETURN OLD;
  END IF;
  RETURN NEW;
END;
$function$
FUNCTION rs_address_owners_truncate_guard
CREATE OR REPLACE FUNCTION public.rs_address_owners_truncate_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  RAISE EXCEPTION 'address_owners is maintained by triggers only' USING ERRCODE = 'RS003';
END;
$function$
FUNCTION rs_address_truncate
CREATE OR REPLACE FUNCTION public.rs_address_truncate()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  DELETE FROM address_owners
  WHERE owner_kind = CASE TG_TABLE_NAME
    WHEN 'accounts' THEN 'account' WHEN 'aliases' THEN 'alias' ELSE 'list' END;
  RETURN NULL;
END;
$function$
FUNCTION rs_address_unique
CREATE OR REPLACE FUNCTION public.rs_address_unique()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
DECLARE
  kind text := CASE TG_TABLE_NAME
    WHEN 'accounts' THEN 'account'
    WHEN 'aliases' THEN 'alias'
    ELSE 'list'
  END;
BEGIN
  IF TG_OP = 'DELETE' THEN
    DELETE FROM address_owners
    WHERE domain_id = OLD.domain_id AND local_part = OLD.local_part
      AND owner_kind = kind AND owner_id = OLD.id;
    RETURN OLD;
  END IF;

  IF TG_OP = 'UPDATE'
     AND OLD.domain_id = NEW.domain_id AND OLD.local_part = NEW.local_part THEN
    RETURN NEW;
  END IF;

  IF TG_OP = 'UPDATE' THEN
    DELETE FROM address_owners
    WHERE domain_id = OLD.domain_id AND local_part = OLD.local_part
      AND owner_kind = kind AND owner_id = OLD.id;
  END IF;

  BEGIN
    INSERT INTO address_owners(domain_id, local_part, owner_kind, owner_id)
    VALUES (NEW.domain_id, NEW.local_part, kind, NEW.id);
  EXCEPTION WHEN unique_violation THEN
    RAISE EXCEPTION 'address already used' USING ERRCODE = 'RS001';
  END;
  RETURN NEW;
END;
$function$
FUNCTION rs_alias_same_domain
CREATE OR REPLACE FUNCTION public.rs_alias_same_domain()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  -- A missing domain or account is left to the foreign keys (23503), so only a real mismatch is ours.
  IF EXISTS (SELECT 1 FROM accounts WHERE id = NEW.account_id AND domain_id <> NEW.domain_id)
     AND EXISTS (SELECT 1 FROM domains WHERE id = NEW.domain_id) THEN
    RAISE EXCEPTION 'alias target is in another domain' USING ERRCODE = 'RS002';
  END IF;
  RETURN NEW;
END;
$function$
FUNCTION rs_blobs_zero_since
CREATE OR REPLACE FUNCTION public.rs_blobs_zero_since()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  IF TG_OP = 'INSERT' THEN
    IF NEW.refcount = 0 THEN
      NEW.zero_since := rs_now();
    END IF;
  ELSIF NEW.refcount = 0 THEN
    IF OLD.refcount <> 0 THEN
      NEW.zero_since := rs_now();
    END IF;
  ELSE
    NEW.zero_since := NULL;
  END IF;
  RETURN NEW;
END;
$function$
FUNCTION rs_folders_no_cycle
CREATE OR REPLACE FUNCTION public.rs_folders_no_cycle()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  IF NEW.parent_id IS NULL THEN
    RETURN NEW;
  END IF;
  -- Serialize every tree mutation of this mailbox. The walk below only sees committed rows, so
  -- two concurrent reparentings (1 under 2 and 2 under 1) would otherwise both pass and commit
  -- a cycle. Lock ordering rule: the mailbox row is always locked FIRST. Statements in plpgsql
  -- take a fresh snapshot after the lock wait, so the walk sees the other session's commit.
  PERFORM 1 FROM mailboxes WHERE id = NEW.mailbox_id FOR UPDATE;
  IF EXISTS (
    WITH RECURSIVE chain(id, depth) AS (
      SELECT NEW.parent_id, 1
      UNION ALL
      SELECT f.parent_id, c.depth + 1
      FROM folders f JOIN chain c
        ON f.mailbox_id = NEW.mailbox_id AND f.id = c.id
      WHERE f.parent_id IS NOT NULL AND c.depth < 65
    )
    SELECT 1 FROM chain WHERE id = NEW.id
  ) THEN
    RAISE EXCEPTION 'folder cycle' USING ERRCODE = 'RS002';
  END IF;
  IF EXISTS (
    WITH RECURSIVE chain(id, depth) AS (
      SELECT NEW.parent_id, 1
      UNION ALL
      SELECT f.parent_id, c.depth + 1
      FROM folders f JOIN chain c
        ON f.mailbox_id = NEW.mailbox_id AND f.id = c.id
      WHERE f.parent_id IS NOT NULL AND c.depth < 65
    )
    SELECT 1 FROM chain WHERE depth >= 64
  ) THEN
    RAISE EXCEPTION 'folder tree too deep' USING ERRCODE = 'RS002';
  END IF;
  RETURN NEW;
END;
$function$
FUNCTION rs_list_member_same_domain
CREATE OR REPLACE FUNCTION public.rs_list_member_same_domain()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  IF NEW.account_id IS NOT NULL AND EXISTS (
       SELECT 1 FROM accounts a JOIN lists l ON l.id = NEW.list_id
       WHERE a.id = NEW.account_id AND a.domain_id <> l.domain_id) THEN
    RAISE EXCEPTION 'list member is in another domain' USING ERRCODE = 'RS002';
  END IF;
  RETURN NEW;
END;
$function$
FUNCTION rs_list_members_seq
CREATE OR REPLACE FUNCTION public.rs_list_members_seq()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  PERFORM 1 FROM lists WHERE id = NEW.list_id FOR NO KEY UPDATE;
  SELECT COALESCE(MAX(seq), 0) + 1 INTO NEW.seq FROM list_members WHERE list_id = NEW.list_id;
  RETURN NEW;
END;
$function$
FUNCTION rs_messages_refcount
CREATE OR REPLACE FUNCTION public.rs_messages_refcount()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  IF TG_OP = 'INSERT' THEN
    UPDATE blobs SET refcount = refcount + 1 WHERE hash = NEW.blob_hash;
    RETURN NEW;
  ELSIF TG_OP = 'DELETE' THEN
    UPDATE blobs SET refcount = refcount - 1 WHERE hash = OLD.blob_hash;
    RETURN OLD;
  ELSIF OLD.blob_hash IS DISTINCT FROM NEW.blob_hash THEN
    UPDATE blobs SET refcount = refcount - 1 WHERE hash = OLD.blob_hash;
    UPDATE blobs SET refcount = refcount + 1 WHERE hash = NEW.blob_hash;
  END IF;
  RETURN NEW;
END;
$function$
FUNCTION rs_now
CREATE OR REPLACE FUNCTION public.rs_now()
 RETURNS bigint
 LANGUAGE sql
 STABLE PARALLEL SAFE
RETURN (EXTRACT(epoch FROM statement_timestamp()))::bigint
