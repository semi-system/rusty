CONSTRAINT mail_log.mail_log_sender_not_null NOT NULL sender
CONSTRAINT mail_log.mail_log_sender_valid CHECK (length(sender) <= 320)
CONSTRAINT mail_log.mail_log_status_valid CHECK (status IS NULL OR length(status) <= 16)
CONSTRAINT mailboxes.mailboxes_account_id_fkey FOREIGN KEY (account_id) REFERENCES accounts(id) ON DELETE CASCADE
CONSTRAINT mailboxes.mailboxes_account_id_key UNIQUE (account_id)
CONSTRAINT mailboxes.mailboxes_account_id_not_null NOT NULL account_id
CONSTRAINT mailboxes.mailboxes_id_not_null NOT NULL id
CONSTRAINT mailboxes.mailboxes_last_delivery_valid CHECK (last_delivery_at IS NULL OR last_delivery_at >= 0)
CONSTRAINT mailboxes.mailboxes_next_change_seq_not_null NOT NULL next_change_seq
CONSTRAINT mailboxes.mailboxes_next_change_seq_valid CHECK (next_change_seq >= 1)
CONSTRAINT mailboxes.mailboxes_next_folder_id_not_null NOT NULL next_folder_id
CONSTRAINT mailboxes.mailboxes_next_folder_id_valid CHECK (next_folder_id >= 1)
CONSTRAINT mailboxes.mailboxes_next_msg_id_not_null NOT NULL next_msg_id
CONSTRAINT mailboxes.mailboxes_next_msg_id_valid CHECK (next_msg_id >= 1)
CONSTRAINT mailboxes.mailboxes_pkey PRIMARY KEY (id)
CONSTRAINT mailboxes.mailboxes_uid_validity_not_null NOT NULL uid_validity
CONSTRAINT mailboxes.mailboxes_uid_validity_valid CHECK (uid_validity > 0)
CONSTRAINT mailboxes.mailboxes_used_bytes_not_null NOT NULL used_bytes
CONSTRAINT mailboxes.mailboxes_used_bytes_valid CHECK (used_bytes >= 0)
CONSTRAINT messages.messages_blob_fkey FOREIGN KEY (blob_store_id, blob_hash) REFERENCES blobs(store_id, hash) ON DELETE RESTRICT
CONSTRAINT messages.messages_blob_hash_not_null NOT NULL blob_hash
CONSTRAINT messages.messages_blob_store_id_not_null NOT NULL blob_store_id
CONSTRAINT messages.messages_flags_not_null NOT NULL flags
CONSTRAINT messages.messages_flags_valid CHECK (flags >= 0 AND flags <= 31)
CONSTRAINT messages.messages_folder_id_not_null NOT NULL folder_id
CONSTRAINT messages.messages_from_addr_not_null NOT NULL from_addr
CONSTRAINT messages.messages_id_not_null NOT NULL id
CONSTRAINT messages.messages_internal_date_not_null NOT NULL internal_date
CONSTRAINT messages.messages_mailbox_id_fkey FOREIGN KEY (mailbox_id) REFERENCES mailboxes(id) ON DELETE CASCADE
CONSTRAINT messages.messages_mailbox_id_folder_id_fkey FOREIGN KEY (mailbox_id, folder_id) REFERENCES folders(mailbox_id, id)
CONSTRAINT messages.messages_mailbox_id_folder_id_uid_key UNIQUE (mailbox_id, folder_id, uid)
CONSTRAINT messages.messages_mailbox_id_not_null NOT NULL mailbox_id
CONSTRAINT messages.messages_pkey PRIMARY KEY (mailbox_id, id)
CONSTRAINT messages.messages_size_not_null NOT NULL size
CONSTRAINT messages.messages_size_valid CHECK (size > 0)
CONSTRAINT messages.messages_subject_not_null NOT NULL subject
CONSTRAINT messages.messages_thread_id_not_null NOT NULL thread_id
CONSTRAINT messages.messages_to_addrs_not_null NOT NULL to_addrs
CONSTRAINT messages.messages_uid_not_null NOT NULL uid
CONSTRAINT messages.messages_uid_valid CHECK (uid >= 1)
CONSTRAINT plans.plans_config_not_null NOT NULL config
CONSTRAINT plans.plans_id_not_null NOT NULL id
CONSTRAINT plans.plans_name_key UNIQUE (name)
CONSTRAINT plans.plans_name_not_null NOT NULL name
CONSTRAINT plans.plans_name_valid CHECK (length(name) > 0)
CONSTRAINT plans.plans_pkey PRIMARY KEY (id)
CONSTRAINT platform_settings.platform_settings_enabled_not_null NOT NULL enabled
CONSTRAINT platform_settings.platform_settings_key_not_null NOT NULL key
CONSTRAINT platform_settings.platform_settings_key_valid CHECK (key = 'protocol_pop3'::text)
CONSTRAINT platform_settings.platform_settings_pkey PRIMARY KEY (key)
CONSTRAINT platform_settings.platform_settings_updated_at_not_null NOT NULL updated_at
CONSTRAINT platform_settings.platform_settings_updated_valid CHECK (updated_at >= 0)
CONSTRAINT schema_compat.schema_compat_min_binary_not_null NOT NULL min_binary
CONSTRAINT schema_compat.schema_compat_min_valid CHECK (min_binary >= 0)
CONSTRAINT schema_compat.schema_compat_pkey PRIMARY KEY (version)
CONSTRAINT schema_compat.schema_compat_version_not_null NOT NULL version
CONSTRAINT schema_compat.schema_compat_version_valid CHECK (version >= 1)
CONSTRAINT sealed_secrets.sealed_secrets_created_at_not_null NOT NULL created_at
CONSTRAINT sealed_secrets.sealed_secrets_key_id_not_null NOT NULL key_id
CONSTRAINT sealed_secrets.sealed_secrets_key_id_valid CHECK (key_id ~ '^[0-9a-f]{16}$'::text)
CONSTRAINT sealed_secrets.sealed_secrets_kind_valid CHECK (owner_kind ~ '^[a-z0-9_-]{1,32}$'::text)
CONSTRAINT sealed_secrets.sealed_secrets_owner_id_not_null NOT NULL owner_id
CONSTRAINT sealed_secrets.sealed_secrets_owner_kind_not_null NOT NULL owner_kind
CONSTRAINT sealed_secrets.sealed_secrets_pkey PRIMARY KEY (owner_kind, owner_id, purpose)
CONSTRAINT sealed_secrets.sealed_secrets_purpose_not_null NOT NULL purpose
CONSTRAINT sealed_secrets.sealed_secrets_purpose_valid CHECK (purpose ~ '^[a-z0-9_-]{1,32}$'::text)
CONSTRAINT sealed_secrets.sealed_secrets_sealed_not_null NOT NULL sealed
CONSTRAINT sealed_secrets.sealed_secrets_size_valid CHECK (octet_length(sealed) >= 16 AND octet_length(sealed) <= 66000)
CONSTRAINT sealed_secrets.sealed_secrets_updated_at_not_null NOT NULL updated_at
CONSTRAINT service_heartbeats.service_heartbeats_detail_not_null NOT NULL detail
CONSTRAINT service_heartbeats.service_heartbeats_detail_valid CHECK (length(detail) <= 2048)
CONSTRAINT service_heartbeats.service_heartbeats_instance_not_null NOT NULL instance
CONSTRAINT service_heartbeats.service_heartbeats_instance_valid CHECK (length(instance) >= 1 AND length(instance) <= 128)
CONSTRAINT service_heartbeats.service_heartbeats_last_seen_not_null NOT NULL last_seen
CONSTRAINT service_heartbeats.service_heartbeats_pkey PRIMARY KEY (service, instance)
CONSTRAINT service_heartbeats.service_heartbeats_service_not_null NOT NULL service
CONSTRAINT service_heartbeats.service_heartbeats_service_valid CHECK (service = ANY (ARRAY['smtp-in'::text, 'submission'::text, 'imap'::text, 'outbound'::text, 'gc'::text, 'admin'::text]))
CONSTRAINT service_heartbeats.service_heartbeats_started_at_not_null NOT NULL started_at
CONSTRAINT service_heartbeats.service_heartbeats_status_not_null NOT NULL status
CONSTRAINT service_heartbeats.service_heartbeats_status_valid CHECK (status = ANY (ARRAY['ok'::text, 'degraded'::text]))
CONSTRAINT service_heartbeats.service_heartbeats_version_not_null NOT NULL version
CONSTRAINT service_heartbeats.service_heartbeats_version_valid CHECK (length(version) >= 1 AND length(version) <= 64)
