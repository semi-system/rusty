TRIGGER messages.messages_usage_upd CREATE TRIGGER messages_usage_upd AFTER UPDATE ON messages REFERENCING OLD TABLE AS old_rows NEW TABLE AS new_rows FOR EACH STATEMENT EXECUTE FUNCTION rs_messages_usage_upd()
FUNCTION rs_address_owners_guard
CREATE OR REPLACE FUNCTION public.rs_address_owners_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  IF pg_trigger_depth() < 2 THEN
    RAISE EXCEPTION 'address_owners is maintained by triggers only' USING ERRCODE = 'RS003';
  END IF;
  IF TG_OP = 'DELETE' THEN
    RETURN OLD;
  END IF;
  RETURN NEW;
END;
$function$
FUNCTION rs_address_owners_truncate_guard
CREATE OR REPLACE FUNCTION public.rs_address_owners_truncate_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  RAISE EXCEPTION 'address_owners is maintained by triggers only' USING ERRCODE = 'RS003';
END;
$function$
FUNCTION rs_address_truncate
CREATE OR REPLACE FUNCTION public.rs_address_truncate()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
AS $function$
BEGIN
  DELETE FROM address_owners
  WHERE owner_kind = CASE TG_TABLE_NAME
    WHEN 'accounts' THEN 'account' WHEN 'aliases' THEN 'alias' ELSE 'list' END;
  RETURN NULL;
END;
$function$
FUNCTION rs_address_unique
CREATE OR REPLACE FUNCTION public.rs_address_unique()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
AS $function$
DECLARE
  kind text := CASE TG_TABLE_NAME
    WHEN 'accounts' THEN 'account'
    WHEN 'aliases' THEN 'alias'
    ELSE 'list'
  END;
BEGIN
  IF TG_OP = 'DELETE' THEN
    DELETE FROM address_owners
    WHERE domain_id = OLD.domain_id AND local_part = OLD.local_part
      AND owner_kind = kind AND owner_id = OLD.id;
    RETURN OLD;
  END IF;

  IF TG_OP = 'UPDATE'
     AND OLD.domain_id = NEW.domain_id AND OLD.local_part = NEW.local_part THEN
    RETURN NEW;
  END IF;

  IF TG_OP = 'UPDATE' THEN
    DELETE FROM address_owners
    WHERE domain_id = OLD.domain_id AND local_part = OLD.local_part
      AND owner_kind = kind AND owner_id = OLD.id;
  END IF;

  BEGIN
    INSERT INTO address_owners(domain_id, local_part, owner_kind, owner_id)
    VALUES (NEW.domain_id, NEW.local_part, kind, NEW.id);
  EXCEPTION WHEN unique_violation THEN
    RAISE EXCEPTION 'address already used' USING ERRCODE = 'RS001';
  END;
  RETURN NEW;
END;
$function$
FUNCTION rs_admin_grant_same_domain
CREATE OR REPLACE FUNCTION public.rs_admin_grant_same_domain()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  IF NEW.domain_id IS NOT NULL AND EXISTS (SELECT 1 FROM accounts WHERE id = NEW.account_id AND domain_id <> NEW.domain_id) THEN
    RAISE EXCEPTION 'a domain administrator must be an account of that domain' USING ERRCODE = 'RS002';
  END IF;
  RETURN NEW;
END;
$function$
FUNCTION rs_alias_same_domain
CREATE OR REPLACE FUNCTION public.rs_alias_same_domain()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  -- A missing domain or account is left to the foreign keys (23503), so only a real mismatch is ours.
  IF EXISTS (SELECT 1 FROM accounts WHERE id = NEW.account_id AND domain_id <> NEW.domain_id)
     AND EXISTS (SELECT 1 FROM domains WHERE id = NEW.domain_id) THEN
    RAISE EXCEPTION 'alias target is in another domain' USING ERRCODE = 'RS002';
  END IF;
  RETURN NEW;
END;
$function$
FUNCTION rs_blobs_zero_since
CREATE OR REPLACE FUNCTION public.rs_blobs_zero_since()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  IF TG_OP = 'INSERT' THEN
    IF NEW.refcount = 0 THEN
      NEW.zero_since := rs_now();
    END IF;
  ELSIF NEW.refcount = 0 THEN
    IF OLD.refcount <> 0 THEN
      NEW.zero_since := rs_now();
    END IF;
  ELSE
    NEW.zero_since := NULL;
  END IF;
  RETURN NEW;
END;
$function$
FUNCTION rs_dkim_keys_immutable
CREATE OR REPLACE FUNCTION public.rs_dkim_keys_immutable()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION 'a published DKIM key never changes: use a new selector' USING ERRCODE = '23514';
END
$function$
FUNCTION rs_folders_no_cycle
CREATE OR REPLACE FUNCTION public.rs_folders_no_cycle()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  IF NEW.parent_id IS NULL THEN
    RETURN NEW;
  END IF;
  -- Serialize every tree mutation of this mailbox. The walk below only sees committed rows, so
  -- two concurrent reparentings (1 under 2 and 2 under 1) would otherwise both pass and commit
  -- a cycle. Lock ordering rule: the mailbox row is always locked FIRST. Statements in plpgsql
  -- take a fresh snapshot after the lock wait, so the walk sees the other session's commit.
  PERFORM 1 FROM mailboxes WHERE id = NEW.mailbox_id FOR UPDATE;
  IF EXISTS (
    WITH RECURSIVE chain(id, depth) AS (
      SELECT NEW.parent_id, 1
      UNION ALL
      SELECT f.parent_id, c.depth + 1
      FROM folders f JOIN chain c
        ON f.mailbox_id = NEW.mailbox_id AND f.id = c.id
      WHERE f.parent_id IS NOT NULL AND c.depth < 65
    )
    SELECT 1 FROM chain WHERE id = NEW.id
  ) THEN
    RAISE EXCEPTION 'folder cycle' USING ERRCODE = 'RS002';
  END IF;
  IF EXISTS (
    WITH RECURSIVE chain(id, depth) AS (
      SELECT NEW.parent_id, 1
      UNION ALL
      SELECT f.parent_id, c.depth + 1
      FROM folders f JOIN chain c
        ON f.mailbox_id = NEW.mailbox_id AND f.id = c.id
      WHERE f.parent_id IS NOT NULL AND c.depth < 65
    )
    SELECT 1 FROM chain WHERE depth >= 64
  ) THEN
    RAISE EXCEPTION 'folder tree too deep' USING ERRCODE = 'RS002';
  END IF;
  RETURN NEW;
END;
$function$
FUNCTION rs_heartbeat
CREATE OR REPLACE FUNCTION public.rs_heartbeat(p_service text, p_instance text, p_version text, p_uptime_secs bigint, p_status text, p_detail text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
AS $function$
DECLARE
  svc text;
BEGIN
  svc := CASE session_user
    WHEN 'rusty_smtp_in' THEN 'smtp-in'
    WHEN 'rusty_submission' THEN 'submission'
    WHEN 'rusty_imap' THEN 'imap'
    WHEN 'rusty_outbound' THEN 'outbound'
    WHEN 'rusty_gc' THEN 'gc'
    WHEN 'rusty_admin' THEN 'admin'
    ELSE p_service
  END;
  INSERT INTO service_heartbeats (service, instance, version, started_at, last_seen, status, detail)
  VALUES (svc, p_instance, p_version, rs_now() - greatest(p_uptime_secs, 0), rs_now(), p_status, p_detail)
  ON CONFLICT (service, instance) DO UPDATE
    SET version = EXCLUDED.version, started_at = EXCLUDED.started_at, last_seen = EXCLUDED.last_seen, status = EXCLUDED.status, detail = EXCLUDED.detail;
END;
$function$
FUNCTION rs_list_member_same_domain
CREATE OR REPLACE FUNCTION public.rs_list_member_same_domain()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  IF NEW.account_id IS NOT NULL AND EXISTS (
       SELECT 1 FROM accounts a JOIN lists l ON l.id = NEW.list_id
       WHERE a.id = NEW.account_id AND a.domain_id <> l.domain_id) THEN
    RAISE EXCEPTION 'list member is in another domain' USING ERRCODE = 'RS002';
  END IF;
  RETURN NEW;
END;
$function$
FUNCTION rs_list_members_seq
CREATE OR REPLACE FUNCTION public.rs_list_members_seq()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  PERFORM 1 FROM lists WHERE id = NEW.list_id FOR NO KEY UPDATE;
  SELECT COALESCE(MAX(seq), 0) + 1 INTO NEW.seq FROM list_members WHERE list_id = NEW.list_id;
  RETURN NEW;
END;
$function$
FUNCTION rs_messages_refcount
CREATE OR REPLACE FUNCTION public.rs_messages_refcount()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public'
AS $function$
BEGIN
  IF TG_OP = 'INSERT' THEN
    UPDATE blobs SET refcount = refcount + 1 WHERE store_id = NEW.blob_store_id AND hash = NEW.blob_hash;
    RETURN NEW;
  ELSIF TG_OP = 'DELETE' THEN
    UPDATE blobs SET refcount = refcount - 1 WHERE store_id = OLD.blob_store_id AND hash = OLD.blob_hash;
    RETURN OLD;
  ELSIF OLD.blob_hash IS DISTINCT FROM NEW.blob_hash OR OLD.blob_store_id IS DISTINCT FROM NEW.blob_store_id THEN
    UPDATE blobs SET refcount = refcount - 1 WHERE store_id = OLD.blob_store_id AND hash = OLD.blob_hash;
    UPDATE blobs SET refcount = refcount + 1 WHERE store_id = NEW.blob_store_id AND hash = NEW.blob_hash;
  END IF;
  RETURN NEW;
END;
$function$
FUNCTION rs_messages_usage_del
CREATE OR REPLACE FUNCTION public.rs_messages_usage_del()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
AS $function$
BEGIN
  UPDATE mailboxes m SET used_bytes = greatest(m.used_bytes - s.total, 0)
    FROM (SELECT mailbox_id, sum(size) AS total FROM old_rows WHERE deleted_at IS NULL GROUP BY mailbox_id) s WHERE m.id = s.mailbox_id;
  RETURN NULL;
END;
$function$
FUNCTION rs_messages_usage_ins
CREATE OR REPLACE FUNCTION public.rs_messages_usage_ins()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
AS $function$
BEGIN
  UPDATE mailboxes m SET used_bytes = m.used_bytes + s.total
    FROM (SELECT mailbox_id, sum(size) AS total FROM new_rows WHERE deleted_at IS NULL GROUP BY mailbox_id) s WHERE m.id = s.mailbox_id;
  RETURN NULL;
END;
$function$
FUNCTION rs_messages_usage_upd
CREATE OR REPLACE FUNCTION public.rs_messages_usage_upd()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
AS $function$
BEGIN
  UPDATE mailboxes m SET used_bytes = greatest(m.used_bytes + s.delta, 0)
    FROM (SELECT n.mailbox_id, sum(CASE WHEN n.deleted_at IS NULL THEN n.size ELSE 0 END - CASE WHEN o.deleted_at IS NULL THEN o.size ELSE 0 END) AS delta
            FROM new_rows n JOIN old_rows o ON o.mailbox_id = n.mailbox_id AND o.id = n.id GROUP BY n.mailbox_id) s
   WHERE m.id = s.mailbox_id AND s.delta <> 0;
  RETURN NULL;
END;
$function$
FUNCTION rs_notify_admin
CREATE OR REPLACE FUNCTION public.rs_notify_admin()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
AS $function$
DECLARE
  d text;
BEGIN
  -- TG_ARGV[0] is the kind, TG_ARGV[1] the column that holds the domain's id (empty: the kind has none).
  IF TG_ARGV[1] <> '' THEN
    IF TG_OP = 'DELETE' THEN d := to_jsonb(OLD) ->> TG_ARGV[1]; ELSE d := to_jsonb(NEW) ->> TG_ARGV[1]; END IF;
  END IF;
  PERFORM pg_notify('rusty_admin', TG_ARGV[0] || ':' || COALESCE(d, ''));
  RETURN NULL;
END
$function$
FUNCTION rs_notify_admin_backend
CREATE OR REPLACE FUNCTION public.rs_notify_admin_backend()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
AS $function$
DECLARE
  d bigint;
BEGIN
  SELECT domain_id INTO d FROM blob_stores WHERE id = CASE WHEN TG_OP = 'DELETE' THEN OLD.store_id ELSE NEW.store_id END;
  PERFORM pg_notify('rusty_admin', 'storage:' || COALESCE(d::text, ''));
  RETURN NULL;
END
$function$
FUNCTION rs_notify_jobs
CREATE OR REPLACE FUNCTION public.rs_notify_jobs()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
AS $function$
BEGIN
  PERFORM pg_notify('rusty_jobs', '');
  RETURN NULL;
END
$function$
FUNCTION rs_notify_mailboxes
CREATE OR REPLACE FUNCTION public.rs_notify_mailboxes()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
AS $function$
DECLARE
  r record;
BEGIN
  FOR r IN SELECT mailbox_id, max(seq) AS newest FROM new_rows GROUP BY mailbox_id LOOP
    PERFORM pg_notify('rusty_mailbox', r.mailbox_id::text || ':' || r.newest::text);
  END LOOP;
  RETURN NULL;
END
$function$
FUNCTION rs_now
CREATE OR REPLACE FUNCTION public.rs_now()
 RETURNS bigint
 LANGUAGE sql
 STABLE PARALLEL SAFE
RETURN (EXTRACT(epoch FROM statement_timestamp()))::bigint
FUNCTION rs_sealed_domain_cleanup
CREATE OR REPLACE FUNCTION public.rs_sealed_domain_cleanup()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'public', 'pg_temp'
AS $function$
BEGIN
  DELETE FROM sealed_secrets WHERE owner_kind = 'domain' AND owner_id = OLD.id;
  RETURN OLD;
END
$function$
