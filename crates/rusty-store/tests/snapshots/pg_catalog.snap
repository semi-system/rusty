CONSTRAINT accounts.accounts_closed_at_valid CHECK (closed_at IS NULL OR closed_at >= 0)
CONSTRAINT accounts.accounts_config_not_null NOT NULL config
CONSTRAINT accounts.accounts_created_at_not_null NOT NULL created_at
CONSTRAINT accounts.accounts_domain_id_fkey FOREIGN KEY (domain_id) REFERENCES domains(id) ON DELETE RESTRICT
CONSTRAINT accounts.accounts_domain_id_not_null NOT NULL domain_id
CONSTRAINT accounts.accounts_id_domain UNIQUE (id, domain_id)
CONSTRAINT accounts.accounts_id_not_null NOT NULL id
CONSTRAINT accounts.accounts_last_login_valid CHECK (last_login_at IS NULL OR last_login_at >= 0)
CONSTRAINT accounts.accounts_local_part_domain_id_key UNIQUE (local_part, domain_id)
CONSTRAINT accounts.accounts_local_part_not_null NOT NULL local_part
CONSTRAINT accounts.accounts_local_part_valid CHECK (length(local_part) > 0 AND local_part = lower(local_part))
CONSTRAINT accounts.accounts_must_change_password_not_null NOT NULL must_change_password
CONSTRAINT accounts.accounts_pkey PRIMARY KEY (id)
CONSTRAINT accounts.accounts_plan_id_fkey FOREIGN KEY (plan_id) REFERENCES plans(id) ON DELETE RESTRICT
CONSTRAINT accounts.accounts_status_not_null NOT NULL status
CONSTRAINT accounts.accounts_status_valid CHECK (status = ANY (ARRAY['active'::text, 'locked'::text, 'disabled'::text]))
