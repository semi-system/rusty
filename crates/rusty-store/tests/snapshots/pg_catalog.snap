CONSTRAINT address_owners.address_owners_owner_id_not_null NOT NULL owner_id
CONSTRAINT address_owners.address_owners_owner_kind_check CHECK (owner_kind = ANY (ARRAY['account'::text, 'alias'::text, 'list'::text]))
CONSTRAINT address_owners.address_owners_owner_kind_not_null NOT NULL owner_kind
CONSTRAINT address_owners.address_owners_owner_kind_owner_id_key UNIQUE (owner_kind, owner_id)
CONSTRAINT address_owners.address_owners_pkey PRIMARY KEY (domain_id, local_part)
CONSTRAINT admin_grants.admin_grants_account_id_fkey FOREIGN KEY (account_id) REFERENCES accounts(id) ON DELETE CASCADE
CONSTRAINT admin_grants.admin_grants_account_id_not_null NOT NULL account_id
CONSTRAINT admin_grants.admin_grants_created_at_not_null NOT NULL created_at
CONSTRAINT admin_grants.admin_grants_domain_id_fkey FOREIGN KEY (domain_id) REFERENCES domains(id) ON DELETE CASCADE
CONSTRAINT admin_grants.admin_grants_helpdesk_domain CHECK (NOT helpdesk OR domain_id IS NOT NULL)
CONSTRAINT admin_grants.admin_grants_helpdesk_not_null NOT NULL helpdesk
CONSTRAINT admin_grants.admin_grants_pkey PRIMARY KEY (account_id)
CONSTRAINT aliases.aliases_account_id_fkey FOREIGN KEY (account_id) REFERENCES accounts(id) ON DELETE CASCADE
CONSTRAINT aliases.aliases_account_id_not_null NOT NULL account_id
