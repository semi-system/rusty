-- trigger aliases_same_domain_ins on aliases
CREATE TRIGGER aliases_same_domain_ins BEFORE INSERT ON aliases BEGIN SELECT RAISE(ABORT, 'invalid: alias target is in another domain') WHERE (SELECT domain_id FROM accounts WHERE id = NEW.account_id) <> NEW.domain_id AND EXISTS (SELECT 1 FROM domains WHERE id = NEW.domain_id); END;

