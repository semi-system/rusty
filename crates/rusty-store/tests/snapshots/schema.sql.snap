CREATE TRIGGER list_members_same_domain_upd BEFORE UPDATE OF account_id, list_id ON list_members BEGIN SELECT RAISE(ABORT, 'invalid: list member is in another domain') WHERE NEW.account_id IS NOT NULL AND (SELECT domain_id FROM accounts WHERE id = NEW.account_id) <> (SELECT domain_id FROM lists WHERE id = NEW.list_id); END;

-- trigger list_members_seq_ins on list_members
CREATE TRIGGER list_members_seq_ins AFTER INSERT ON list_members WHEN NEW.seq IS NULL BEGIN UPDATE list_members SET seq = ( SELECT COALESCE(MAX(seq), 0) + 1 FROM list_members WHERE list_id = NEW.list_id AND rowid <> NEW.rowid ) WHERE rowid = NEW.rowid; END;

