CREATE TRIGGER accounts_addr_unique_upd BEFORE UPDATE ON accounts BEGIN SELECT RAISE(ABORT, 'conflict: address already used by an alias or list') WHERE EXISTS (SELECT 1 FROM aliases WHERE local_part = NEW.local_part AND domain_id = NEW.domain_id) OR EXISTS (SELECT 1 FROM lists WHERE local_part = NEW.local_part AND domain_id = NEW.domain_id); END;

