CREATE INDEX messages_thread ON messages (mailbox_id, thread_id);

-- table accounts on accounts
CREATE TABLE accounts ( id INTEGER PRIMARY KEY, local_part TEXT NOT NULL CHECK (length(local_part) > 0 AND local_part = lower(local_part)), domain_id INTEGER NOT NULL REFERENCES domains(id) ON DELETE RESTRICT, plan_id INTEGER REFERENCES plans(id) ON DELETE RESTRICT, password_hash TEXT, status TEXT NOT NULL CHECK (status IN ('active','locked','disabled')), config TEXT NOT NULL DEFAULT '{}' CHECK (json_valid(config)), created_at INTEGER NOT NULL, UNIQUE (local_part, domain_id) ) STRICT;

-- table aliases on aliases
CREATE TABLE aliases ( id INTEGER PRIMARY KEY, local_part TEXT NOT NULL CHECK (length(local_part) > 0 AND local_part = lower(local_part)), domain_id INTEGER NOT NULL REFERENCES domains(id) ON DELETE RESTRICT, account_id INTEGER NOT NULL REFERENCES accounts(id) ON DELETE CASCADE, UNIQUE (local_part, domain_id) ) STRICT;

-- table blobs on blobs
CREATE TABLE blobs ( hash TEXT PRIMARY KEY CHECK (length(hash) = 64 AND hash NOT GLOB '*[^0-9a-f]*'), size INTEGER NOT NULL CHECK (size >= 0), refcount INTEGER NOT NULL DEFAULT 0 CHECK (refcount >= 0) , zero_since INTEGER CHECK (zero_since IS NULL OR zero_since >= 0)) STRICT;

-- table change_log on change_log
CREATE TABLE change_log ( mailbox_id INTEGER NOT NULL REFERENCES mailboxes(id) ON DELETE CASCADE, seq INTEGER NOT NULL CHECK (seq >= 1), kind TEXT NOT NULL CHECK (kind IN ('message','folder')), item_id INTEGER NOT NULL, op TEXT NOT NULL CHECK (op IN ('create','update','destroy')), PRIMARY KEY (mailbox_id, seq) ) STRICT;

-- table deliveries on deliveries
CREATE TABLE deliveries ( mailbox_id INTEGER NOT NULL, delivery_id BLOB NOT NULL CHECK (length(delivery_id) = 32), message_id INTEGER NOT NULL, blob_hash TEXT NOT NULL CHECK (length(blob_hash) = 64), created_at INTEGER NOT NULL, PRIMARY KEY (mailbox_id, delivery_id), FOREIGN KEY (mailbox_id, message_id) REFERENCES messages(mailbox_id, id) ON DELETE CASCADE ) STRICT;

-- table domains on domains
CREATE TABLE domains ( id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE CHECK (length(name) > 0 AND name = lower(name)), config TEXT NOT NULL DEFAULT '{}' CHECK (json_valid(config)), created_at INTEGER NOT NULL ) STRICT;

-- table folders on folders
CREATE TABLE folders ( mailbox_id INTEGER NOT NULL REFERENCES mailboxes(id) ON DELETE CASCADE, id INTEGER NOT NULL CHECK (id >= 1), parent_id INTEGER, name TEXT NOT NULL CHECK (length(name) > 0 AND instr(name, '/') = 0), role TEXT NOT NULL DEFAULT 'custom' CHECK (role IN ('inbox','sent','drafts','trash','spam','archive','custom')), uid_validity INTEGER NOT NULL CHECK (uid_validity > 0), next_uid INTEGER NOT NULL DEFAULT 1 CHECK (next_uid >= 1), PRIMARY KEY (mailbox_id, id), CHECK (parent_id IS NULL OR parent_id <> id), FOREIGN KEY (mailbox_id, parent_id) REFERENCES folders(mailbox_id, id) ON DELETE NO ACTION ) STRICT;

-- table keywords on keywords
CREATE TABLE keywords ( mailbox_id INTEGER NOT NULL, message_id INTEGER NOT NULL, keyword TEXT NOT NULL CHECK (length(keyword) BETWEEN 1 AND 255 AND keyword = lower(keyword)), PRIMARY KEY (mailbox_id, message_id, keyword), FOREIGN KEY (mailbox_id, message_id) REFERENCES messages(mailbox_id, id) ON DELETE CASCADE ) STRICT;

-- table list_members on list_members
CREATE TABLE list_members ( list_id INTEGER NOT NULL REFERENCES lists(id) ON DELETE CASCADE, account_id INTEGER REFERENCES accounts(id) ON DELETE CASCADE, external TEXT, CHECK ((account_id IS NULL) <> (external IS NULL)), UNIQUE (list_id, account_id), UNIQUE (list_id, external) ) STRICT;

-- table lists on lists
CREATE TABLE lists ( id INTEGER PRIMARY KEY, local_part TEXT NOT NULL CHECK (length(local_part) > 0 AND local_part = lower(local_part)), domain_id INTEGER NOT NULL REFERENCES domains(id) ON DELETE RESTRICT, UNIQUE (local_part, domain_id) ) STRICT;

-- table mailboxes on mailboxes
CREATE TABLE mailboxes ( id INTEGER PRIMARY KEY, account_id INTEGER NOT NULL UNIQUE REFERENCES accounts(id) ON DELETE CASCADE, next_msg_id INTEGER NOT NULL DEFAULT 1 CHECK (next_msg_id >= 1), next_change_seq INTEGER NOT NULL DEFAULT 1 CHECK (next_change_seq >= 1), uid_validity INTEGER NOT NULL CHECK (uid_validity > 0) , next_folder_id INTEGER NOT NULL DEFAULT 1 CHECK (next_folder_id >= 1)) STRICT;

-- table messages on messages
CREATE TABLE messages ( mailbox_id INTEGER NOT NULL, id INTEGER NOT NULL, folder_id INTEGER NOT NULL, uid INTEGER NOT NULL CHECK (uid >= 1), blob_hash TEXT NOT NULL REFERENCES blobs(hash) ON DELETE RESTRICT, size INTEGER NOT NULL CHECK (size > 0), internal_date INTEGER NOT NULL, subject TEXT NOT NULL DEFAULT '', from_addr TEXT NOT NULL DEFAULT '', to_addrs TEXT NOT NULL DEFAULT '', message_id_hdr TEXT, thread_id INTEGER NOT NULL, flags INTEGER NOT NULL DEFAULT 0 CHECK (flags BETWEEN 0 AND 31), deleted_at INTEGER, PRIMARY KEY (mailbox_id, id), FOREIGN KEY (mailbox_id) REFERENCES mailboxes(id) ON DELETE CASCADE, FOREIGN KEY (mailbox_id, folder_id) REFERENCES folders(mailbox_id, id) ON DELETE NO ACTION, UNIQUE (mailbox_id, folder_id, uid) ) STRICT;

-- table plans on plans
CREATE TABLE plans ( id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE CHECK (length(name) > 0), config TEXT NOT NULL DEFAULT '{}' CHECK (json_valid(config)) ) STRICT;

-- trigger accounts_addr_unique_ins on accounts
CREATE TRIGGER accounts_addr_unique_ins BEFORE INSERT ON accounts BEGIN SELECT RAISE(ABORT, 'conflict: address already used by an alias or list') WHERE EXISTS (SELECT 1 FROM aliases WHERE local_part = NEW.local_part AND domain_id = NEW.domain_id) OR EXISTS (SELECT 1 FROM lists WHERE local_part = NEW.local_part AND domain_id = NEW.domain_id); END;

