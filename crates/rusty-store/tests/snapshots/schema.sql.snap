CREATE TRIGGER aliases_addr_unique_ins BEFORE INSERT ON aliases BEGIN SELECT RAISE(ABORT, 'conflict: address already used by an account or list') WHERE EXISTS (SELECT 1 FROM accounts WHERE local_part = NEW.local_part AND domain_id = NEW.domain_id) OR EXISTS (SELECT 1 FROM lists WHERE local_part = NEW.local_part AND domain_id = NEW.domain_id); END;

-- trigger aliases_addr_unique_upd on aliases
CREATE TRIGGER aliases_addr_unique_upd BEFORE UPDATE ON aliases BEGIN SELECT RAISE(ABORT, 'conflict: address already used by an account or list') WHERE EXISTS (SELECT 1 FROM accounts WHERE local_part = NEW.local_part AND domain_id = NEW.domain_id) OR EXISTS (SELECT 1 FROM lists WHERE local_part = NEW.local_part AND domain_id = NEW.domain_id); END;

-- trigger blobs_zero_since_ins on blobs
CREATE TRIGGER blobs_zero_since_ins AFTER INSERT ON blobs WHEN NEW.refcount = 0 BEGIN UPDATE blobs SET zero_since = unixepoch() WHERE hash = NEW.hash; END;

-- trigger blobs_zero_since_referenced on blobs
CREATE TRIGGER blobs_zero_since_referenced AFTER UPDATE OF refcount ON blobs WHEN NEW.refcount > 0 BEGIN UPDATE blobs SET zero_since = NULL WHERE hash = NEW.hash; END;

-- trigger blobs_zero_since_released on blobs
CREATE TRIGGER blobs_zero_since_released AFTER UPDATE OF refcount ON blobs WHEN NEW.refcount = 0 AND OLD.refcount <> 0 BEGIN UPDATE blobs SET zero_since = unixepoch() WHERE hash = NEW.hash; END;

-- trigger folders_no_cycle on folders
CREATE TRIGGER folders_no_cycle BEFORE UPDATE OF parent_id ON folders WHEN NEW.parent_id IS NOT NULL BEGIN SELECT RAISE(ABORT, 'folder cycle') WHERE EXISTS ( WITH RECURSIVE chain(id, depth) AS ( SELECT NEW.parent_id, 1 UNION ALL SELECT f.parent_id, c.depth + 1 FROM folders f JOIN chain c ON f.mailbox_id = NEW.mailbox_id AND f.id = c.id WHERE f.parent_id IS NOT NULL AND c.depth < 65 ) SELECT 1 FROM chain WHERE id = NEW.id ); SELECT RAISE(ABORT, 'folder tree too deep') WHERE EXISTS ( WITH RECURSIVE chain(id, depth) AS ( SELECT NEW.parent_id, 1 UNION ALL SELECT f.parent_id, c.depth + 1 FROM folders f JOIN chain c ON f.mailbox_id = NEW.mailbox_id AND f.id = c.id WHERE f.parent_id IS NOT NULL AND c.depth < 65 ) SELECT 1 FROM chain WHERE depth >= 64 ); END;

-- trigger lists_addr_unique_ins on lists
CREATE TRIGGER lists_addr_unique_ins BEFORE INSERT ON lists BEGIN SELECT RAISE(ABORT, 'conflict: address already used by an account or alias') WHERE EXISTS (SELECT 1 FROM accounts WHERE local_part = NEW.local_part AND domain_id = NEW.domain_id) OR EXISTS (SELECT 1 FROM aliases WHERE local_part = NEW.local_part AND domain_id = NEW.domain_id); END;

-- trigger lists_addr_unique_upd on lists
CREATE TRIGGER lists_addr_unique_upd BEFORE UPDATE ON lists BEGIN SELECT RAISE(ABORT, 'conflict: address already used by an account or alias') WHERE EXISTS (SELECT 1 FROM accounts WHERE local_part = NEW.local_part AND domain_id = NEW.domain_id) OR EXISTS (SELECT 1 FROM aliases WHERE local_part = NEW.local_part AND domain_id = NEW.domain_id); END;

-- trigger messages_refcount_del on messages
CREATE TRIGGER messages_refcount_del AFTER DELETE ON messages BEGIN UPDATE blobs SET refcount = refcount - 1 WHERE hash = OLD.blob_hash; END;

-- trigger messages_refcount_ins on messages
CREATE TRIGGER messages_refcount_ins AFTER INSERT ON messages BEGIN UPDATE blobs SET refcount = refcount + 1 WHERE hash = NEW.blob_hash; END;

-- trigger messages_refcount_upd on messages
CREATE TRIGGER messages_refcount_upd AFTER UPDATE OF blob_hash ON messages WHEN OLD.blob_hash <> NEW.blob_hash BEGIN UPDATE blobs SET refcount = refcount - 1 WHERE hash = OLD.blob_hash; UPDATE blobs SET refcount = refcount + 1 WHERE hash = NEW.blob_hash; END;
