CREATE TRIGGER list_members_same_domain_ins BEFORE INSERT ON list_members BEGIN SELECT RAISE(ABORT, 'invalid: list member is in another domain') WHERE NEW.account_id IS NOT NULL AND (SELECT domain_id FROM accounts WHERE id = NEW.account_id) <> (SELECT domain_id FROM lists WHERE id = NEW.list_id); END;

